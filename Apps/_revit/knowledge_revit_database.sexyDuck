    "EnneadTab.tab\\Resource.panel\\check_error_log.pushbutton\\check_error_log_script.py": {
        "alias": "Check Error Log",
        "doc": "Open the EnneadTab error log in your browser to see reported bugs and their status.\n\nEvery error EnneadTab catches is filed here. Use it to check whether the problem\nyou just hit is already known, to see what has been fixed, or to add detail to a\nreport you sent in.",
        "icon": "EnneadTab.tab\\Resource.panel\\check_error_log.pushbutton\\icon.png",
        "is_popular": false,
