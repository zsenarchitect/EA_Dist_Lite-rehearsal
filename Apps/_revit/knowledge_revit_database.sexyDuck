    "EnneadTab.tab\\Resource.panel\\tell_me_version.pushbutton\\tell_me_version_script.py": {
        "alias": "Tell Me Version",
        "doc": "Show which EnneadTab version you are on and when it last updated successfully.\n\nWorth checking when you file a bug, when you want to confirm a fix has reached\nyour machine, or when you and a teammate need to be sure you are running the\nsame build.",
