        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\Sync All.pulldown\\see you later.pushbutton\\schedule_reopen_script.py": {
        "alias": "See You Again",
        "doc": "Smart session scheduler that prepares your Revit environment for your next work session. \n\nThis time-saving utility allows you to:\n- Schedule your current Revit files to reopen automatically\n- Choose when they reopen: in minutes, tomorrow morning, or next Monday\n- Skip the lengthy file loading process when you return to work\n- Maintain your exact workspace configuration between sessions\n\nPerfect for teams working with large projects that take significant time to open each day.",
        "icon": "EnneadTab.tab\\Tools.panel\\Sync All.pulldown\\see you later.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Tools.panel\\Sync All.pulldown\\see you later.pushbutton\\schedule_reopen_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\Sync All.pulldown\\sync all projects and close.pushbutton\\sycn all proj_script.py": {
        "alias": "Sync All Open Proj and Close",
        "doc": "Sync every open model with central, then close them, leaving Revit running.\n\nUse it when you are switching projects or stepping away: all your work reaches the\ncentral files and the documents are closed behind you, but Revit stays open so you\ncan start something else.",
        "icon": "EnneadTab.tab\\Tools.panel\\Sync All.pulldown\\sync all projects and close.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Tools.panel\\Sync All.pulldown\\sync all projects and close.pushbutton\\sycn all proj_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\Sync All.pulldown\\sync all projects.pushbutton\\sycn all proj_script.py": {
        "alias": "Sync All Open Proj",
        "doc": "Sync every open model with central in one click and keep working.\n\nAll open documents are synchronized and left open, so your changes reach the team\nwithout interrupting what you are doing. Worth running regularly through the day\ninstead of hoarding a whole afternoon of work.",
        "icon": "EnneadTab.tab\\Tools.panel\\Sync All.pulldown\\sync all projects.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Tools.panel\\Sync All.pulldown\\sync all projects.pushbutton\\sycn all proj_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\ai_render.pushbutton\\ai_render_script.py": {
        "alias": "AI Render",
        "doc": "Render the current view through Ennead's in-house AI style library.\n\nQueue several renders at once and carry on modeling while they run. Your gallery\nfollows you between machines, so a render you start at one desk can be picked up\nat another.\n\nFeatures:\n- Style references pulled straight from the Ennead library\n- Prompt helpers from ennead-ai.com to sharpen a description\n- Queue multiple views and collect the results in one gallery",
        "icon": "EnneadTab.tab\\Tools.panel\\ai_render.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Tools.panel\\ai_render.pushbutton\\ai_render_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\apply_panel_radius_UI.pushbutton\\apply_panel_radius_UI_script.py": {
        "alias": "Apply Panel Radius",
        "doc": "Push the host curtain wall's radius into the panels sitting on it.\n\nCurved curtain walls are found for you and their radius is written into a\nparameter on every panel, so panel families bend to match the wall instead of\nbeing dialed in by hand one at a time. The facade stays consistent as the\ncurvature changes.\n\nUsage:\n1. Run the button to open the window\n2. Pick the panel type and the parameter that should receive the radius\n3. Apply, then check the count of updated panels",
        "icon": "EnneadTab.tab\\Tools.panel\\apply_panel_radius_UI.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Tools.panel\\apply_panel_radius_UI.pushbutton\\apply_panel_radius_UI_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\area2mass.pushbutton\\area2mass_script.py": {
        "alias": "Area2Mass",
        "doc": "Turn area boundaries into solid mass families and place them back in the project.\n\nPick an area scheme and every area becomes its own loadable mass, extruded up to the\nnext level above and dropped exactly where the original area sits. Handy for zoning\ndiagrams, gross-area studies and quick massing pulled straight from your area plans.\n\nFeatures:\n- Choose which area scheme to convert\n- Each mass lands in place, so no repositioning is needed\n- Masses are ordinary families you can schedule, filter and color",
        "icon": "EnneadTab.tab\\Tools.panel\\area2mass.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Tools.panel\\area2mass.pushbutton\\area2mass_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\batch_cut.pushbutton\\batch_cut_script.py": {
        "alias": "Batch Cut Elements",
        "doc": "Powerful batch cutting utility for curtain wall systems.\n\nThis tool enables efficient creation of void cuts across multiple curtain panels.\nFeatures:\n- Batch process curtain walls or individual panels\n- Support for multiple selection methods\n- Intelligent void detection and validation\n- Transaction-safe operations with error handling\n\nUsage:\n1. Select curtain walls or panels\n2. Choose void geometry\n3. Apply cuts across all selected elements\n",
        "icon": "EnneadTab.tab\\Tools.panel\\batch_cut.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Tools.panel\\batch_cut.pushbutton\\batch_cut_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\color_design_option.pushbutton\\color_design_option_script.py": {
        "alias": "Color-Code Design Option",
        "doc": "Color-code every element by the design option it belongs to, across the views you pick.\n\nAt a glance you can see which option each element lives in, so nothing gets reviewed or\npresented under the wrong assumption. Ideal for design reviews and pin-ups where several\nalternatives are in play at once.\n\nFeatures:\n- Each design option gets its own color\n- Applies to as many views as you select in one go\n- Colors are a view override, so the model itself is untouched",
        "icon": "EnneadTab.tab\\Tools.panel\\color_design_option.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Tools.panel\\color_design_option.pushbutton\\color_design_option_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\create_finish_floor_by_room.pushbutton\\create_finish_floor_by_room_script.py": {
        "alias": "Finish Floor by Room",
        "doc": "Create finish floors from picked Rooms.\n\nPick rooms in the model, choose a floor type (ranked by your recent usage,\nthen alphabetical), set a level offset (mm and inch are tied), then create\none finish floor per room. All floors land in a single undo step.\n\n- While picking, Rooms and Room Tags are temporarily isolated in the active\n  view so they are easy to select; the view is restored afterwards.\n- Uses each room's own Level; the offset is written to 'Height Offset From Level'.\n- Only the outer room boundary is used (solid finish floor, inner loops ignored).\n- Rooms already given a finish floor by this tool are skipped (no duplicates).\n- Rooms with no boundary / no level / bad geometry are skipped and reported.\n",
        "icon": "EnneadTab.tab\\Tools.panel\\create_finish_floor_by_room.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Tools.panel\\create_finish_floor_by_room.pushbutton\\create_finish_floor_by_room_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\detail_line_from_excel.pushbutton\\detail_line_from_excel_script.py": {
        "alias": "Detail Line By Excel",
        "doc": "Draw detail lines from survey coordinates listed in an Excel file.\n\nPoint data from the spreadsheet is placed at exact coordinates and chained into detail\nlines, then bundled into a group so the whole run can be moved as one piece. Built for\nproperty lines, site boundaries and any linework that has to land on surveyed points.\n\nUsage:\n1. Prepare an Excel file with the survey coordinates\n2. Run the button and point it at that file\n3. The lines are drawn in the current view as a single group",
        "icon": "EnneadTab.tab\\Tools.panel\\detail_line_from_excel.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Tools.panel\\detail_line_from_excel.pushbutton\\detail_line_from_excel_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\dim_text_helper.pushbutton\\dim_text_script.py": {
        "alias": "Dim Text Helper",
        "doc": "Add standard dimension text such as FOG, EOS or FTF to the dimensions you select.\n\nA small floating window stays open while you work, so you can keep selecting dimensions\nand stamping text on them without reopening anything. Choose where the text sits relative\nto the dimension value, and add your own phrases to the list for next time.\n\nFeatures:\n- Common annotations ready to click, plus your own custom entries\n- Control whether the text goes above, below, before or after the value\n- Your custom entries are remembered between sessions\n- Window stays open so you can work through many dimensions in a row",
        "icon": "EnneadTab.tab\\Tools.panel\\dim_text_helper.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Tools.panel\\dim_text_helper.pushbutton\\dim_text_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\disallow_wall_end_joins.pushbutton\\disallow_wall_end_joins_script.py": {
        "alias": "Disallow Wall End Joins",
        "doc": "Disallow end joins on every wall of the wall types you choose.\n\nWalls of the selected types stop auto-joining at their endpoints, which keeps stacked or\nlayered wall assemblies from cleaning up into each other and ruining the intended graphic.\nRuns as a single undo step.\n\nFeatures:\n- Pick one or many wall types and treat every wall of that type at once\n- Both ends of each wall are handled\n- Summary of how many walls were changed",
        "icon": "EnneadTab.tab\\Tools.panel\\disallow_wall_end_joins.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Tools.panel\\disallow_wall_end_joins.pushbutton\\disallow_wall_end_joins_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\explode_axon.pushbutton\\explode_axon_script.py": {
        "alias": "Explode Axon",
        "doc": "Build an exploded axon by lifting each level apart in a 3D view.\n\nElements are grouped by the level they sit on and pulled upward by a spacing you choose,\nso the building reads as separated floor plates. The displacement lives in the view only,\nso the model geometry never moves and you can reset or redo it at any time.\n\nUsage:\n1. Run the button from a 3D view\n2. Pick the categories you want to explode\n3. Enter the spacing in feet between levels",
        "icon": "EnneadTab.tab\\Tools.panel\\explode_axon.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Tools.panel\\explode_axon.pushbutton\\explode_axon_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\general_renamer.pushbutton\\general_renamer_script.py": {
        "alias": "Super Renamer",
        "doc": "Rename views, sheets and families in bulk from one window.\n\nKeeps naming consistent across the project without clicking through the project browser\none item at a time.\n\nFeatures:\n- Add or strip a prefix on the views you select\n- Push view and sheet names to uppercase\n- Rebuild view names from their detail number and sheet number\n- Rename families directly from the same window",
        "icon": "EnneadTab.tab\\Tools.panel\\general_renamer.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Tools.panel\\general_renamer.pushbutton\\general_renamer_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\generic_healthcare_tool.pushbutton\\generic_healthcare_tool_script.py": {
        "alias": "HealthCare Helper",
        "doc": "Open the healthcare toolkit and pick the healthcare task you want to run.\n\nOne menu gathers everything a healthcare project needs, so you do not have to hunt for\nseparate buttons.\n\nFeatures:\n- Read the Ennead healthcare design outline\n- Set up a new healthcare project and edit or open its project data\n- Update the detailed DGSF chart\n- Refresh the department color palette from an Excel file",
        "icon": "EnneadTab.tab\\Tools.panel\\generic_healthcare_tool.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Tools.panel\\generic_healthcare_tool.pushbutton\\generic_healthcare_tool_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\get_inspired.pushbutton\\get_inspired_script.py": {
        "alias": "GetInspired",
        "doc": "Open e.AI rendering website for enhancing and refining your renders!\n\nThis tool opens the e.AI web application (https://enneadtab.com/rendering/home) that helps you:\n- Polish and enhance render outputs\n- Apply post-processing effects\n- Refine render quality and appearance\n- Streamline your rendering workflow\n\nPerfect for visualization specialists looking to take their renders to the next level.\n",
        "icon": "EnneadTab.tab\\Tools.panel\\get_inspired.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Tools.panel\\get_inspired.pushbutton\\get_inspired_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\inspect_cutter.pushbutton\\inspect_cutter_script.py": {
        "alias": "Reset Join/Cut",
        "doc": "Strip every join and cut relationship from the elements you have selected.\n\nWhen geometry is fighting itself and you cannot tell which element is cutting or joining\nwhich, this gives you a clean slate to rebuild from. A report lists each relationship that\nwas found and removed.\n\nFeatures:\n- Handles both cutting and joining relationships\n- Reports what was undone, element by element\n- One undo step, so you can put it all back if needed",
        "icon": "EnneadTab.tab\\Tools.panel\\inspect_cutter.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Tools.panel\\inspect_cutter.pushbutton\\inspect_cutter_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\join_all_coln_floor.pushbutton\\join_all_coln_floor_script.py": {
        "alias": "Join Selected Elements",
        "doc": "Join horizontal elements to vertical ones in bulk, such as floors into columns.\n\nInstead of picking pairs by hand, choose the two categories and every overlapping pair in\nthe model is joined in one pass. Cleans up the slab-to-column edges that otherwise show\nthrough in sections and elevations.\n\nUsage:\n1. Pick the horizontal category, for example Floors or Ceilings\n2. Pick the vertical category, for example Columns or Structural Columns\n3. Review the count of joins made in the output window",
        "icon": "EnneadTab.tab\\Tools.panel\\join_all_coln_floor.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Tools.panel\\join_all_coln_floor.pushbutton\\join_all_coln_floor_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\make_template_from_current_view.pushbutton\\make_template_from_current_view_script.py": {
        "alias": "Make Template From Current View",
        "doc": "Save the current view's settings as a view template and apply it everywhere it belongs.\n\nUnlike the built-in Revit command, this also repairs a template that was created under the\nwrong view type, which is what makes templates show up in the wrong group in the browser.\nEvery view that used the old template is moved onto the new one and the old template is\nremoved, so you are not left with duplicates.\n\nUsage:\n1. Set up the view exactly how you want the template to look\n2. Run the button and name the template\n3. Reuse the existing name to replace the template the view is already on",
        "icon": "EnneadTab.tab\\Tools.panel\\make_template_from_current_view.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Tools.panel\\make_template_from_current_view.pushbutton\\make_template_from_current_view_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\mcp_server.smartbutton\\mcp_server_script.py": {
        "alias": "MCP Server",
        "doc": "Turn the EnneadTab AI bridge for this Revit session on or off.\n\nWhile it is on, an AI assistant can look at the open model and carry out changes for you in\nthis session. The button shows the current state, so one click starts the bridge and the\nnext click shuts it down again.\n\nFeatures:\n- Only the Revit session you started it from is exposed\n- The bridge stops as soon as you toggle it off or close Revit\n- pyRevit Routes must be enabled first, and you are told if it is not",
        "icon": "EnneadTab.tab\\Tools.panel\\mcp_server.smartbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Tools.panel\\mcp_server.smartbutton\\mcp_server_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\move_curtain_grids.stack\\move_curtain_grid_hori.pushbutton\\move_curtain_grid_hori_script.py": {
        "alias": "Align H. Curtain Grid To Detail Lines/Levels(Elevation)",
        "doc": "Snap horizontal curtain grids onto the detail lines or levels that cross them.\n\nDraw your intended grid heights as detail lines, or just use the levels already in the\nelevation, and the curtain grids move to match. Beats nudging each grid line by hand when a\nfacade rhythm changes.\n\nUsage:\n1. Open an elevation view of the curtain wall\n2. Run the button and pick the detail lines or levels to align to\n3. Pick the curtain grids that should move",
        "icon": "EnneadTab.tab\\Tools.panel\\move_curtain_grids.stack\\move_curtain_grid_hori.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Tools.panel\\move_curtain_grids.stack\\move_curtain_grid_hori.pushbutton\\move_curtain_grid_hori_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\move_curtain_grids.stack\\move_curtain_grid_verti.pushbutton\\move_curtain_grid_verti_script.py": {
        "alias": "Align V. Curtain Grid To Detail Lines/Grids(Plan)",
        "doc": "Snap vertical curtain grids onto the detail lines or column grids that cross them.\n\nDraw your intended mullion positions as detail lines, or just use the column grids already\nin the plan, and the curtain grids move to match. Beats nudging each grid line by hand when\na facade rhythm changes.\n\nUsage:\n1. Open a plan view showing the curtain wall\n2. Run the button and pick the detail lines or grids to align to\n3. Pick the curtain grids that should move",
        "icon": "EnneadTab.tab\\Tools.panel\\move_curtain_grids.stack\\move_curtain_grid_verti.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Tools.panel\\move_curtain_grids.stack\\move_curtain_grid_verti.pushbutton\\move_curtain_grid_verti_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\nyu_export_mapping.pushbutton\\nyu_export_mapping_script.py": {
        "alias": "NYU Export CAD Layer Mapping",
        "doc": "Apply NYU CAD Layer Standards to DWG Export Settings.\nThis tool maps Revit categories to NYU standard layer names and colors.\nAll subcategories will use the parent category's layer settings.",
        "icon": "EnneadTab.tab\\Tools.panel\\nyu_export_mapping.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Tools.panel\\nyu_export_mapping.pushbutton\\nyu_export_mapping_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\open_doc_silently.pushbutton\\open_doc_silently_script.py": {
        "alias": "Open Doc(s) Siliently",
        "doc": "Open many Revit files in one go without stopping for warning dialogs.\n\nWarnings that would normally halt the queue are answered for you, so a batch of models can\nopen unattended while you do something else. A summary at the end says which files opened\nand which did not.\n\nFeatures:\n- Optional audit on open\n- Optional detached opening with no worksets loaded\n- Summary report of every file in the batch",
        "icon": "EnneadTab.tab\\Tools.panel\\open_doc_silently.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Tools.panel\\open_doc_silently.pushbutton\\open_doc_silently_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\pim_number_fixer.pushbutton\\pim_number_fixer_script.py": {
        "alias": "Pim Number Fixer",
        "doc": "\nPim Number Fixer\n\nThis tool allows users to batch rename DWG and PDF files by updating or inserting a PIM number into their filenames.\nIt provides a simple UI to select files, preview the new filenames, and perform the renaming operation.\nThe tool also remembers the last used PIM number for convenience.\n\nTypical use cases:\n- Standardizing file naming conventions for project documentation.\n- Quickly updating PIM numbers in multiple files after project changes.\n\nNote: This tool operates on the file system and does not require an open Revit document.\n",
        "icon": "EnneadTab.tab\\Tools.panel\\pim_number_fixer.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Tools.panel\\pim_number_fixer.pushbutton\\pim_number_fixer_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\random_deselect.pushbutton\\random_deselect_script.py": {
        "alias": "Random Deselect",
        "doc": "Random deselection tool for Revit elements.\n\nThis tool allows you to randomly deselect a portion of your currently selected elements.\nPerfect for when you have too many elements selected and want to reduce the selection\nto a manageable subset for further operations.\n\nFeatures:\n- Uses PyRevit input slider to control percentage of elements to keep\n- Random selection ensures unbiased element reduction\n- Preserves original selection order for consistency\n- Safe operation with proper error handling\n\nUsage:\n1. Select elements you want to work with\n2. Run this tool\n3. Use the slider to set percentage of elements to keep (0-100%)\n4. Confirm to apply random deselection\n",
        "icon": "EnneadTab.tab\\Tools.panel\\random_deselect.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Tools.panel\\random_deselect.pushbutton\\random_deselect_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\set_filled_region_border_line.pushbutton\\set_filled_region_border_line_script.py": {
        "alias": "Set FilledRegion Border Style",
        "doc": "Set the border line style on all the filled regions you have selected.\n\nBrings a whole drawing's hatches onto the same graphic standard in one move instead of\nediting each region's boundary. Works on regions nested inside groups too, as long as you\ntab-select them.\n\nUsage:\n1. Select the filled regions, using Tab to reach any inside a group\n2. Run the button and pick the line style you want on their borders",
        "icon": "EnneadTab.tab\\Tools.panel\\set_filled_region_border_line.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Tools.panel\\set_filled_region_border_line.pushbutton\\set_filled_region_border_line_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\tag_align.pushbutton\\tag_align_script.py": {
        "alias": "Tag Aligner",
        "doc": "Line up scattered tags horizontally or vertically against one reference tag.\n\nA small floating window stays open while you work, so you can keep selecting groups of tags\nand straightening them without reopening anything. Turns a messy sheet of hand-dragged tags\ninto clean, readable annotation.\n\nUsage:\n1. Select the tags you want to line up\n2. Click align horizontally or vertically in the floating window\n3. Repeat on the next group; the window stays open",
        "icon": "EnneadTab.tab\\Tools.panel\\tag_align.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Tools.panel\\tag_align.pushbutton\\tag_align_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\toggle content_UI.pushbutton\\toggle content_UI_script.py": {
        "alias": "Toggle Contents",
        "doc": "Pin, hide and tidy whole categories of content across many views from one window.\n\nEverything you normally toggle view by view is gathered in a single floating panel, so a\nsheet set can be cleaned up or locked down in a couple of clicks instead of a long crawl\nthrough the project browser.\n\nFeatures:\n- Pin or unpin dimensions, keynote tags, viewports and title blocks\n- Hide or show categories on the sheets you pick, permanently or as a temporary view state\n- Turn grid and level bubble heads on or off\n- Hide viewport borders for a clean pin-up",
        "icon": "EnneadTab.tab\\Tools.panel\\toggle content_UI.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Tools.panel\\toggle content_UI.pushbutton\\toggle content_UI_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\Tools.panel\\translate_AI.pushbutton\\AI_translate_script.py": {
        "alias": "AI Translate",
        "doc": "Translate sheet and view names into another language, with a review step first.\n\nCovers 15 languages including Chinese, Japanese, Korean, Spanish, French, German, Arabic and\nHindi, and leans on each country's official AEC vocabulary so the wording reads the way a\nlocal consultant would write it, not the way a generic translator would.\n\nUsage:\n1. Pick the sheets or views to translate and the target language\n2. Review the proposed names side by side with the originals\n3. Approve, and only the names you accepted are written back",
        "icon": "EnneadTab.tab\\Tools.panel\\translate_AI.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Tools.panel\\translate_AI.pushbutton\\AI_translate_script.py",
        "tab": "Tools",
        "tab_icon": null
    },
    "EnneadTab.tab\\UI.panel\\BIM_Client.pushbutton\\bim_client_script.py": {
        "alias": "BIM Client",
        "doc": "Print a health report for the EnneadTab environment inside this Revit session.\n\nUse it when something is misbehaving and you want to know whether the problem is your model\nor your setup. Nothing in the model is read or changed; the report simply appears in the\noutput window and can be pasted straight into a support message.\n\nFeatures:\n- Names the active document and how many elements it holds\n- Confirms the EnneadTab library and the Revit connection are alive\n- Checks that the AI service responds\n- Flags any missing component instead of failing quietly",
        "icon": "EnneadTab.tab\\UI.panel\\BIM_Client.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\UI.panel\\BIM_Client.pushbutton\\bim_client_script.py",
        "tab": "UI",
        "tab_icon": null
    },
    "EnneadTab.tab\\UI.panel\\Search.pushbutton\\search_script.py": {
        "alias": "Search Command",
        "doc": "Find any Revit or EnneadTab command by typing what you want to do.\n\nSearch by name or by what a tool does, and the best matches come back ranked. Faster than\nhunting through ribbon panels for a button whose exact name you cannot recall.\n\nFeatures:\n- Covers both EnneadTab tools and native Revit commands\n- Shows where on the ribbon each match lives\n- Run the tool straight from the results\n- Reads out the tool's description and links to further help",
        "icon": "EnneadTab.tab\\UI.panel\\Search.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\UI.panel\\Search.pushbutton\\search_script.py",
        "tab": "UI",
        "tab_icon": null
    },
    "EnneadTab.tab\\UI.panel\\open_app_store.pushbutton\\open_app_store_script.py": {
        "alias": "Open App Store",
        "doc": "Open the EnneadTab App Store to browse and install extra tools.\n\nOne place to discover what the office has built, add what you need, and keep what you\nalready have up to date.",
        "icon": "EnneadTab.tab\\UI.panel\\open_app_store.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\UI.panel\\open_app_store.pushbutton\\open_app_store_script.py",
        "tab": "UI",
        "tab_icon": null
    },
    "EnneadTab.tab\\UI.panel\\ownership_inspect.pushbutton\\ownership_inspect_script.py": {
        "alias": "Ownership Inspect",
        "doc": "See who created, owns and last changed every element in a workshared model.\n\nOne scan builds a searchable table so you know exactly whom to ask before you touch\nsomething, and which view an annotation actually lives in.\n\nFeatures:\n- Search bar, category filter and an owned-by-me-only toggle\n- Separate tab listing views and their owners\n- Select, zoom to, or open the host view straight from the table\n- Read-only: nothing in the model is changed",
        "icon": "EnneadTab.tab\\UI.panel\\ownership_inspect.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\UI.panel\\ownership_inspect.pushbutton\\ownership_inspect_script.py",
        "tab": "UI",
        "tab_icon": null
    },
    "EnneadTab.tab\\UI.panel\\pick_absolute_similar.pushbutton\\pick_absolute_similar_script.py": {
        "alias": "Pick Absolute Similar",
        "doc": "Find elements with matching parameters by comparing parameter values across elements.",
        "icon": "EnneadTab.tab\\UI.panel\\pick_absolute_similar.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\UI.panel\\pick_absolute_similar.pushbutton\\pick_absolute_similar_script.py",
        "tab": "UI",
        "tab_icon": null
    },
    "EnneadTab.tab\\UI.panel\\place_views_on_sheets.pushbutton\\place_views_on_sheets_script.py": {
        "alias": "Place Views On Sheets",
        "doc": "Catch every newly created view and get it named, templated and onto a sheet.\n\nA floating window lists the views that appeared since you started, so nothing gets left\nunnamed or unplaced. Keep it open while you work and finish each view as it shows up.\n\nFeatures:\n- Rename a view, or accept the suggested name based on its sheet\n- Drop the view onto a sheet from the same window\n- Assign a scope box and a view template while you are there\n- Window stays open so Revit is still usable behind it",
        "icon": "EnneadTab.tab\\UI.panel\\place_views_on_sheets.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\UI.panel\\place_views_on_sheets.pushbutton\\place_views_on_sheets_script.py",
        "tab": "UI",
        "tab_icon": null
    },
    "EnneadTab.tab\\UI.panel\\prefilter_selection.pushbutton\\prefilter_selection_script.py": {
        "alias": "Prefilter Selection",
        "doc": "Limit what a window selection can pick up, so a crowded view stops fighting you.\n\nChoose the categories you care about first, then drag a window and only those categories\nare caught. Saves the usual dance of selecting everything and then filtering it back down.\n\nFeatures:\n- Turn on as many categories at once as you need\n- Works with normal window and crossing selection\n- Setting stays active until you clear it",
        "icon": "EnneadTab.tab\\UI.panel\\prefilter_selection.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\UI.panel\\prefilter_selection.pushbutton\\prefilter_selection_script.py",
        "tab": "UI",
        "tab_icon": null
    },
    "EnneadTab.tab\\UI.panel\\toggle_warning_mode.smartbutton\\toggle_warning_mode_script.py": {
        "alias": "Toggle Warnings",
        "doc": "Show warnings in the active view.",
        "icon": "EnneadTab.tab\\UI.panel\\toggle_warning_mode.smartbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\UI.panel\\toggle_warning_mode.smartbutton\\toggle_warning_mode_script.py",
        "tab": "UI",
        "tab_icon": null
    },
    "EnneadTab.tab\\UI.panel\\what_happened.pushbutton\\what_happened_script.py": {
        "alias": "What Happened?",
        "doc": "Find out who made, who last edited and who owns whatever you have selected.\n\nAnswers the question you ask whenever something looks wrong: who did this, and can I touch\nit. Also reports the same for the view you are currently in.\n\nFeatures:\n- Creator, last editor and current owner for each selected element\n- Same information for the active view\n- Read-only: nothing in the model is changed",
        "icon": "EnneadTab.tab\\UI.panel\\what_happened.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\UI.panel\\what_happened.pushbutton\\what_happened_script.py",
        "tab": "UI",
        "tab_icon": null
    }
