        "tab_icon": null
    },
    "EnneadTab.tab\\Manage.panel\\working_view_cleanup.pushbutton\\manage_working_view_script.py": {
        "alias": "Manage Working Views",
        "doc": "Review and clean up the views that are not on any sheet, all from one window.\n\nEvery unsheeted view is listed with a thumbnail, so you can judge at a glance\nwhether it is someone's working view or dead weight. Delete the dead ones, or\nprefix names with their creator so ownership is obvious. Good housekeeping before\na submission or a phase change.\n\nFeatures:\n- Thumbnail preview of each working view\n- Filter the list by creator, view type, and name\n- Batch rename with a creator prefix, or delete in bulk",
        "icon": "EnneadTab.tab\\Manage.panel\\working_view_cleanup.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Manage.panel\\working_view_cleanup.pushbutton\\manage_working_view_script.py",
        "tab": "Manage",
        "tab_icon": null
    },
    "EnneadTab.tab\\Manage.panel\\workset_fixer.pushbutton\\fix_workset_script.py": {
        "alias": "WorkSet Manager",
        "doc": "Move elements onto the workset they belong on, in bulk.\n\nSay how each category should be assigned and the tool sweeps the model and\nreassigns everything sitting on the wrong workset. Elements inside design options\nare handled; elements inside groups are not, and are reported instead.\n\nFeatures:\n- Assign by category, by the host element's workset, or by element type\n- Report of everything that could not be moved, and why",
        "icon": "EnneadTab.tab\\Manage.panel\\workset_fixer.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Manage.panel\\workset_fixer.pushbutton\\fix_workset_script.py",
        "tab": "Manage",
        "tab_icon": null
    },
    "EnneadTab.tab\\Resource.panel\\ChatGPT.pushbutton\\ChatGPT_script.py": {
        "alias": "ChatGPT",
        "doc": "Open a ChatGPT window inside Revit, without switching to a browser.\n\nAsk about a Revit workflow, a code question, or a design problem and keep the\nanswer next to the model you are working in. Nothing in the model is touched.",
        "icon": "EnneadTab.tab\\Resource.panel\\ChatGPT.pushbutton\\icon.png",
