    "EnneadTab.tab\\Resource.panel\\mini_bank.pushbutton\\mini_bank_script.py": {
        "alias": "MiniBank",
        "doc": "Check your EA coin balance and where you sit on the office leaderboard.\n\nQuacks add up as you use EnneadTab tools, clear model warnings, and wait your\nturn in the sync queue. The window shows your balance, your standing and your\nrecent transactions; nothing in the model changes.",
        "icon": "EnneadTab.tab\\Resource.panel\\mini_bank.pushbutton\\icon.png",
