    "EnneadTab.tab\\Resource.panel\\beer_tab.pushbutton\\beer_tab_script.py": {
        "alias": "Beer Tab",
        "doc": "Open a guide to the nearest places to get a beer.\n\nA one-click break button for the end of a long modeling session. Opens a\nneighborhood beer guide in your browser. Nothing in the model is touched.",
        "icon": "EnneadTab.tab\\Resource.panel\\beer_tab.pushbutton\\icon.png",
