    "EnneadTab.tab\\Resource.panel\\display_warning_history.pushbutton\\display_warning_history_script.py": {
        "alias": "Display Revit Warning History",
        "doc": "Show how the warning count in a model has moved over time.\n\nEnneadTab quietly records the warning list for your models, so this button can\nreplay that history as a graph: whether warnings are creeping up, when a cleanup\nactually landed, and which ones came back.\n\nUsage:\n1. Choose the graph alone, or the graph plus the full warning detail\n2. Pick the models to report on\n3. Review the history in the output window",
        "icon": "EnneadTab.tab\\Resource.panel\\display_warning_history.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Resource.panel\\display_warning_history.pushbutton\\display_warning_history_script.py",
