    "EnneadTab Library.tab\\Browser.panel\\meta_data_exporter.pushbutton\\meta_data_exporter_script.py": {
        "alias": "MetaData Exporter",
        "doc": "Read every family in the library and record its details for later search.\n\nBuilds the data the Ennead Library browser uses, so families can be found by\ntheir type and view information instead of by filename alone. Run it after\nadding or changing families in the library.\n\nFeatures:\n- Covers every family in the library in one pass\n- Existing records are refreshed, not duplicated",
        "icon": "EnneadTab Library.tab\\Browser.panel\\meta_data_exporter.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Library.tab\\Browser.panel\\meta_data_exporter.pushbutton\\meta_data_exporter_script.py",
        "tab": "Browser",
        "tab_icon": null
    },
    "EnneadTab Library.tab\\Contents.panel\\how to.pushbutton\\instruction to library_script.py": {
        "alias": "How to Use Ennead Library",
        "doc": "Explains how to load a family from the Ennead Library into your model.\n\nClick a family icon in the library to load it. Families saved in an older\nRevit version are upgraded for you as they load, so they are ready to use\nstraight away.",
        "icon": "EnneadTab Library.tab\\Contents.panel\\how to.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Library.tab\\Contents.panel\\how to.pushbutton\\instruction to library_script.py",
