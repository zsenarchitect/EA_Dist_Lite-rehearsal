        "alias": "Fillet Area Corner",
        "doc": "Round the corners of every area boundary in the active view.\n\nFilleted boundary lines are drawn at each corner of every area and\ngrouped per area, giving area diagrams a soft look without redrawing the\nboundaries by hand. The areas themselves are left in place.",
        "icon": "EnneadTab Tailor.tab\\Proj. 1643.panel\\Lenox Hill.pulldown\\fillet_area.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 1643.panel\\Lenox Hill.pulldown\\fillet_area.pushbutton\\fillet_area_script.py",
        "tab": "Proj. 1643",
        "tab_icon": null
    },
