    "EnneadTab.tab\\Resource.panel\\EnneadTab_Setting_UI.pushbutton\\EnneadTab_Setting_UI_script.py": {
        "alias": "EnneadTab Setting",
        "doc": "Personalize how EnneadTab looks and behaves, from one settings window.\n\nChoose which tabs and extensions show up on the ribbon, switch between the Lite\nand Pro tool sets, set colors and notification preferences, and decide how chatty\nthe duck gets. Your choices are remembered for next time.\n\nFeatures:\n- Show or hide individual EnneadTab tabs and extensions\n- Toggle between the Lite and Pro tool sets\n- Sound, notification, and duck behavior preferences",
        "icon": "EnneadTab.tab\\Resource.panel\\EnneadTab_Setting_UI.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Resource.panel\\EnneadTab_Setting_UI.pushbutton\\EnneadTab_Setting_UI_script.py",
        "tab": "Resource",
        "tab_icon": null
    },
    "EnneadTab.tab\\Resource.panel\\app_store.pushbutton\\app_store_script.py": {
        "alias": "App Store",
        "doc": "Open the EnneadTab App Store to browse and install extra tools.\n\nShows the curated catalog of EnneadTab utilities and add-ons, with installing and\nupdating handled for you. Use it to pick up a tool you do not have yet, or to\nrefresh one that has a newer version waiting.",
        "icon": "EnneadTab.tab\\Resource.panel\\app_store.pushbutton\\icon.png",
