    "EnneadTab Library.tab\\Browser.panel\\library_family_browser.pushbutton\\family_browser_script.py": {
        "alias": "Family Browser",
        "doc": "A simple window that can help you search the family from AppliedComputing Library.\n\nDisclaimer: EnneadTab only help you find the family, but is not participating in the creation and maintainance of the family library.",
