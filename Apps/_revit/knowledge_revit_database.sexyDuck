    "EnneadTab Tailor.tab\\Proj. 1643.panel\\Lenox Hill.pulldown\\excel_to_diagram.pushbutton\\excel_to_diagram_script.py": {
        "alias": "Excel2Diagram",
        "doc": "Build the Lenox Hill program bubble diagram from the program Excel file.\n\nThe program spreadsheet is read and the shading and title families in the\nprogram shading view are updated: every bubble is sized to its program\narea and filled in with count, unit area, NSF, DGSF and notes.\n\nFeatures:\n- One bubble per program line, resized to match the Excel area\n- Titles filled in automatically, no retyping\n- Names that appear in the Excel but not in the model, or the other way\n  around, are reported so the two lists can be reconciled",
        "icon": "EnneadTab Tailor.tab\\Proj. 1643.panel\\Lenox Hill.pulldown\\excel_to_diagram.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 1643.panel\\Lenox Hill.pulldown\\excel_to_diagram.pushbutton\\excel_to_diagram_script.py",
        "tab": "Proj. 1643",
        "tab_icon": null
    },
