    "EnneadTab Tailor.tab\\Proj. 2317.panel\\Kimmel.pulldown\\assign_door_mat.pushbutton\\assign_door_mat_script.py": {
        "alias": "Assign Door Mat",
        "doc": "Assign panel and frame materials to every door in the latest phase at once.\n\nYou pick one material for door panels and one for door frames, and every door\nin the newest phase gets both assigned in a single undoable step. Doors that\nbelong to a secondary design option are left alone.\n\nFeatures:\n- Only doors in the latest project phase are touched\n- Doors whose material parameters are locked are skipped\n- A message reports how many doors were updated\n\nUsage:\n1. Run the button and pick the panel material\n2. Pick the frame material\n3. Read the confirmation message",
        "icon": "EnneadTab Tailor.tab\\Proj. 2317.panel\\Kimmel.pulldown\\assign_door_mat.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 2317.panel\\Kimmel.pulldown\\assign_door_mat.pushbutton\\assign_door_mat_script.py",
        "tab": "Proj. 2317",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Proj. 2317.panel\\Kimmel.pulldown\\cleanup_dr_tag.pushbutton\\cleanup_dr_tag_script.py": {
        "alias": "Cleanup Dr Tag",
        "doc": "Cleanup 'TAG_Door_work' tags that are tagging elements with 'NEST' in their Type Mark.",
        "icon": "EnneadTab Tailor.tab\\Proj. 2317.panel\\Kimmel.pulldown\\cleanup_dr_tag.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 2317.panel\\Kimmel.pulldown\\cleanup_dr_tag.pushbutton\\cleanup_dr_tag_script.py",
        "tab": "Proj. 2317",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Proj. 2317.panel\\Kimmel.pulldown\\room_to_door_mark.pushbutton\\room_to_door_mark_script.py": {
        "alias": "[DEPRECATED] Room To Door Mark",
        "doc": "Renumber door Marks in the Renovation 1 phase to match the room each door serves.\n\nEvery door takes the number of the room it opens into. When several doors serve\nthe same room, a letter suffix keeps each Mark unique. The whole renumber is one\nundo step.\n\nFeatures:\n- Doors owned by another user or locked in a design option are reported and skipped\n- Nested door types are left out of the renumbering\n- Doors with no room on either side are flagged in the report so you can fix the data",
        "icon": "EnneadTab Tailor.tab\\Proj. 2317.panel\\Kimmel.pulldown\\room_to_door_mark.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 2317.panel\\Kimmel.pulldown\\room_to_door_mark.pushbutton\\room_to_door_mark_script.py",
        "tab": "Proj. 2317",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Proj. 2317.panel\\Kimmel.pulldown\\test_door_data.pushbutton\\test_door_data_script.py": {
        "alias": "Test Door Data",
        "doc": "Repair doors that carry more than one Fire Rating parameter with a bad value.\n\nSome doors ended up with duplicate Fire Rating parameters, and one copy holds an\nunusable value. This copies the good reading across to the other Fire Rating\nparameter on the same door, then stamps the emptied one so you can see it was\nalready handled. The whole cleanup is one undo step.\n\nFeatures:\n- Only doors with a bad Fire Rating reading are touched\n- Doors with a single healthy Fire Rating parameter are left alone",
        "icon": "EnneadTab Tailor.tab\\Proj. 2317.panel\\Kimmel.pulldown\\test_door_data.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 2317.panel\\Kimmel.pulldown\\test_door_data.pushbutton\\test_door_data_script.py",
        "tab": "Proj. 2317",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Proj. 2317.panel\\Kimmel.pulldown\\transfer_door_location.pushbutton\\transfer_door_location_script.py": {
        "alias": "Door Location and Mark",
        "doc": "Transfer door location and mark based on room analysis across phases. \n\nLOCATION PARAMETER:\n- Analyzes all phases to find connected rooms\n- Prioritizes non-corridor rooms over corridors\n- For two valid rooms, selects the smaller one\n- Sets location to room name\n\nMARK PARAMETER:\n- Single door to a room: Mark = Room Number (e.g., \"101\")\n- Multiple doors to same room: Mark = Room Number + A/B/C (e.g., \"101A\", \"101B\")\n- Doors sorted by Element ID for consistent suffix assignment\n\nSPECIAL CASES:\n- Normal room: Location=Room Name, Mark=Room Number\n- Corridor: Location=\"CORRIDOR\", Mark=Corridor Room Number\n- No room around door: Location=\"no room\", Mark=\"no room\"\n- Room exists but no name: Location=\"missing room name\", Mark=Room Number\n- Room exists but no number: Location=Room Name, Mark=\"missing room number\"\n\nPHASES:\n- Skips doors created in \"Existing\" phase\n- Processes all other phases until a valid room is found",
        "icon": "EnneadTab Tailor.tab\\Proj. 2317.panel\\Kimmel.pulldown\\transfer_door_location.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 2317.panel\\Kimmel.pulldown\\transfer_door_location.pushbutton\\transfer_door_location_script.py",
        "tab": "Proj. 2317",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Proj. 2317.panel\\Kimmel.pulldown\\update_dr_style_name.pushbutton\\update_dr_style_name_script.py": {
        "alias": "Update Dr Style Name",
        "doc": "Copy the Door Style value into the internal note field on every door.\n\nKeeps the internal note in step with the door style so schedules and filters that\nread the note stay accurate after a style change. Runs across the whole project in\none undo step; doors with no style set are left untouched.",
        "icon": "EnneadTab Tailor.tab\\Proj. 2317.panel\\Kimmel.pulldown\\update_dr_style_name.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 2317.panel\\Kimmel.pulldown\\update_dr_style_name.pushbutton\\update_dr_style_name_script.py",
        "tab": "Proj. 2317",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Proj. 2330.panel\\Studio 54.pulldown\\update_life_safety.pushbutton\\update_life_safety_script.py": {
        "alias": "Update Life Safety",
        "doc": "Recalculate occupant load and egress capacity across every room and door.\n\nReads the occupancy area-per-person on each room, works out the required occupant\nload, and pushes the matching egress capacity onto the doors and stairs that serve\nthem. If anything goes wrong mid-run the model is rolled back untouched.\n\nFeatures:\n- Occupant load targets written back to every room\n- Required clear width and capacity written to egress doors and stairs\n- Stale life safety tags removed from doors no longer on an egress path\n\nUsage:\n1. Run the button and let the calculation finish\n2. Choose whether to display the egress targets, then pick the views to show them in",
        "icon": "EnneadTab Tailor.tab\\Proj. 2330.panel\\Studio 54.pulldown\\update_life_safety.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 2330.panel\\Studio 54.pulldown\\update_life_safety.pushbutton\\update_life_safety_script.py",
        "tab": "Proj. 2330",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Proj. 2412.panel\\Sparc.pulldown\\disjoin_columns_from_wall.pushbutton\\disjoin_columns_from_wall_script.py": {
        "alias": "Disjoin Columns From Walls",
        "doc": "Detach columns from any walls they are currently joined to.\n\nThis utility checks the current selection first; if no columns are selected it will process\nall editable architectural and structural columns in the active document.\n\nA detailed log is printed to the console so you can review which joins were removed or skipped.",
        "icon": "EnneadTab Tailor.tab\\Proj. 2412.panel\\Sparc.pulldown\\disjoin_columns_from_wall.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 2412.panel\\Sparc.pulldown\\disjoin_columns_from_wall.pushbutton\\disjoin_columns_from_wall_script.py",
        "tab": "Proj. 2412",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Proj. 2412.panel\\Sparc.pulldown\\recover_cw3.pushbutton\\recover_cw3_script.py": {
        "alias": "Recover CW-3",
        "doc": "Record or apply CW-3 pier metadata.\n\nUse \"Record\" in the source model to capture pier flags for every\n\"EA_CW-3 (Wrap)\" curtain panel. Use \"Apply\" in the target model to\nreplay the captured flags on matching elements by UniqueId.",
        "icon": "EnneadTab Tailor.tab\\Proj. 2412.panel\\Sparc.pulldown\\recover_cw3.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 2412.panel\\Sparc.pulldown\\recover_cw3.pushbutton\\recover_cw3_script.py",
        "tab": "Proj. 2412",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Proj. 2412.panel\\Sparc.pulldown\\update_furning_wall.pushbutton\\update_furning_wall_script.py": {
        "alias": "Update Furning Wall",
        "doc": "Update Furring Wall\n\n2025-11 discovery: curtain-panel marker families can appear in multiple prefix\ngroups (for example none/left/right). The automation now evaluates every prefix\nvariation when building pier walls, sill walls, and room separation lines so we\ncapture whichever group actually contains host points. Diagnostic logging shows\nwhich groups were used or skipped, making it easier to troubleshoot missing\ngeometry.",
        "icon": "EnneadTab Tailor.tab\\Proj. 2412.panel\\Sparc.pulldown\\update_furning_wall.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 2412.panel\\Sparc.pulldown\\update_furning_wall.pushbutton\\update_furning_wall_script.py",
        "tab": "Proj. 2412",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Proj. 2418.panel\\Texttile.pulldown\\make_filter_legend.pushbutton\\make_filter_legend_script.py": {
        "alias": "Make Filter Legend",
        "doc": "Color-code every generic model family in the view and drop a matching legend on the sheet.\n\nOne filter is created per generic model family found in the active view, each given\nits own color, so panel types read apart at a glance. A legend keying color to family\nname is then placed on the sheet that hosts the view.\n\nUsage:\n1. Open a view that is already placed on a sheet\n2. Run the button and let the filters and legend build",
        "icon": "EnneadTab Tailor.tab\\Proj. 2418.panel\\Texttile.pulldown\\make_filter_legend.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 2418.panel\\Texttile.pulldown\\make_filter_legend.pushbutton\\make_filter_legend_script.py",
        "tab": "Proj. 2418",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Proj. 2419.panel\\SinoChem.pulldown\\chained_family_loading.pushbutton\\chained_family_loading_script.py": {
        "alias": "Chained Family Loading",
        "doc": "Reload a whole stack of nested panel families in the right order in one go.\n\nFacade panel families depend on each other, so loading them by hand in the wrong\norder silently loses edits. Pick a design scenario and this walks the known\ndependency chain, loading each family into the one above it from the bottom up.\nSource families that are finished with are closed as it goes.\n\nUsage:\n1. Open every family in the chain first (see Chained Family Opening)\n2. Run the button and pick the scenario\n3. Watch the load order print out as each family is pushed up the chain",
        "icon": "EnneadTab Tailor.tab\\Proj. 2419.panel\\SinoChem.pulldown\\chained_family_loading.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 2419.panel\\SinoChem.pulldown\\chained_family_loading.pushbutton\\chained_family_loading_script.py",
        "tab": "Proj. 2419",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Proj. 2419.panel\\SinoChem.pulldown\\chained_family_opening.pushbutton\\chained_family_opening_script.py": {
        "alias": "Chained Family Opening",
        "doc": "Open every panel family in the loading chain, including nested ones, ready to edit.\n\nSets up the workspace for Chained Family Loading. Each family in the chain is pulled\nout of the model, saved to your local dump folder, and opened for editing. Families\nnested inside those are opened the same way, all the way down.\n\nFeatures:\n- Local copies are saved so the model itself is never edited in place\n- A message names each family as it opens\n- Run this before Chained Family Loading",
        "icon": "EnneadTab Tailor.tab\\Proj. 2419.panel\\SinoChem.pulldown\\chained_family_opening.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 2419.panel\\SinoChem.pulldown\\chained_family_opening.pushbutton\\chained_family_opening_script.py",
        "tab": "Proj. 2419",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Proj. 2419.panel\\SinoChem.pulldown\\print_all_family_name.pushbutton\\print_all_family_name_script.py": {
        "alias": "Print All Family Name",
        "doc": "List every family currently open for editing in this Revit session.\n\nA quick roll call of the open family editors, printed to the output window. Use it\nto confirm the whole panel chain is open before running Chained Family Loading.\nNothing in the model is changed.",
        "icon": "EnneadTab Tailor.tab\\Proj. 2419.panel\\SinoChem.pulldown\\print_all_family_name.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 2419.panel\\SinoChem.pulldown\\print_all_family_name.pushbutton\\print_all_family_name_script.py",
        "tab": "Proj. 2419",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Proj. 2501.panel\\SAIF.pulldown\\assign_panel_type.pushbutton\\assign_panel_type_script.py": {
        "alias": "Assign Panel Type",
        "doc": "Assign panel type based on side frame width mapping.",
        "icon": "EnneadTab Tailor.tab\\Proj. 2501.panel\\SAIF.pulldown\\assign_panel_type.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 2501.panel\\SAIF.pulldown\\assign_panel_type.pushbutton\\assign_panel_type_script.py",
        "tab": "Proj. 2501",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Proj. 2501.panel\\SAIF.pulldown\\panel_location_map.pushbutton\\panel_location_map_script.py": {
        "alias": "Panel Location Map",
        "doc": "Work out the row and column position of every curtain wall panel and save the map.\n\nEach panel gets matched to its place in the curtain grid, so panels can later be\npicked or reported by row and column instead of by clicking. The finished map is\nsaved with the project and reused by the other SAIF panel tools.\n\nFeatures:\n- Covers every curtain wall panel in the model\n- Panels that sit slightly off grid are still matched by widening the search\n- The model itself is not modified; only the saved map is written",
        "icon": "EnneadTab Tailor.tab\\Proj. 2501.panel\\SAIF.pulldown\\panel_location_map.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 2501.panel\\SAIF.pulldown\\panel_location_map.pushbutton\\panel_location_map_script.py",
        "tab": "Proj. 2501",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Proj. 2512.panel\\MetroTech.pulldown\\dob_sheet_cleanup.pushbutton\\dob_sheet_cleanup_script.py": {
        "alias": "DOB Sheet Cleanup",
        "doc": "Clean up MetroTech (2512) sheets: strip a trailing '.00' and set DOB_Rev to '00'.\n\nRuns on every sheet you are able to edit.\n\nFeatures:\n- Removes a trailing '.00' from the sheet number\n- Sets the DOB_Rev parameter to '00'\n- Sheets owned by another user are skipped and reported, never changed",
        "icon": "EnneadTab Tailor.tab\\Proj. 2512.panel\\MetroTech.pulldown\\dob_sheet_cleanup.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 2512.panel\\MetroTech.pulldown\\dob_sheet_cleanup.pushbutton\\dob_sheet_cleanup_script.py",
        "tab": "Proj. 2512",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Proj. 2512.panel\\MetroTech.pulldown\\invalid_phase_element.pushbutton\\invalid_phase_element_script.py": {
        "alias": "Invalid Phase Element",
        "doc": "Find elements with invalid phase references that cause crashes during regeneration.",
        "icon": "EnneadTab Tailor.tab\\Proj. 2512.panel\\MetroTech.pulldown\\invalid_phase_element.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 2512.panel\\MetroTech.pulldown\\invalid_phase_element.pushbutton\\invalid_phase_element_script.py",
        "tab": "Proj. 2512",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Proj. 2512.panel\\MetroTech.pulldown\\room_bounding_to_area_b_line.pushbutton\\room_bounding_to_area_b_line_script.py": {
        "alias": "Room Bounding To Area Boundary Lines",
        "doc": "Creates area boundary lines from room boundaries in selected Area Plan views.\n\nThe tool processes each selected Area Plan view, finds all rooms on the associated level,\nand creates area boundary lines based on the room boundaries. The newly created area\nboundary lines are grouped by view for easier management.",
        "icon": "EnneadTab Tailor.tab\\Proj. 2512.panel\\MetroTech.pulldown\\room_bounding_to_area_b_line.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 2512.panel\\MetroTech.pulldown\\room_bounding_to_area_b_line.pushbutton\\room_bounding_to_area_b_line_script.py",
        "tab": "Proj. 2512",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Proj. 2512.panel\\MetroTech.pulldown\\update_door_info_by_room.pushbutton\\update_door_info_by_room_script.py": {
        "alias": "Update Door Info by Room",
        "doc": "Update Door Info by Room\n\nThis tool updates door 'Location' and 'Mark' parameters based on the room they belong to.\nIt analyzes all phases to find the most appropriate room for each door.\n\nLOGIC:\n1. Location:\n   - Sets 'Location' parameter to the Room Name.\n   - Prioritizes non-corridor rooms.\n   - If a door connects two valid rooms, picks the smaller room.\n   - Special handling for 'CORRIDOR', 'no room', 'missing room name'.\n\n2. Mark:\n   - Sets 'Mark' parameter to Room Number.\n   - If multiple doors belong to the same room, appends a suffix (A, B, C...).\n   - Doors are sorted by Element ID to ensure consistent suffix assignment.\n\nUSAGE:\nClick the button to run. A transaction will be committed to update the parameters.\n",
        "icon": "EnneadTab Tailor.tab\\Proj. 2512.panel\\MetroTech.pulldown\\update_door_info_by_room.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 2512.panel\\MetroTech.pulldown\\update_door_info_by_room.pushbutton\\update_door_info_by_room_script.py",
        "tab": "Proj. 2512",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Proj. 2526.panel\\St Paul.pulldown\\check_arc_center.pushbutton\\check_arc_center_script.py": {
        "alias": "Check Arc Center",
        "doc": "Find curved walls whose arc center has drifted off the intended setting-out point.\n\nGroups every curved wall in the model by where its arc center falls, so walls that\nshare a center land together and strays stand out. Centers that sit near the\nintended point but not on it are called out as suspicious.\n\nFeatures:\n- Each group lists its wall types and a clickable link to select the walls\n- Nothing in the model is changed; this is a read-only check",
        "icon": "EnneadTab Tailor.tab\\Proj. 2526.panel\\St Paul.pulldown\\check_arc_center.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 2526.panel\\St Paul.pulldown\\check_arc_center.pushbutton\\check_arc_center_script.py",
        "tab": "Proj. 2526",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Proj. 2534.panel\\NYU HQ.pulldown\\monitor_area.pushbutton\\monitor_area_script.py": {
        "alias": "Monitor Area",
        "doc": "Check the designed areas against the program requirement and open a fulfillment report.\n\nEvery area in the model is matched to its line in the program spreadsheet, so you\ncan see at a glance which departments are over, under, or on target. Color schemes\nand the area parameters are refreshed from the match, and a report opens in your\nbrowser.\n\nFeatures:\n- Areas that have no match in the program are called out\n- Color schemes are rebuilt so over and under areas read by color in plan\n- Actual design areas can be written back into the program spreadsheet\n- Department level summary spreadsheets can be exported to the file exchange folder",
        "icon": "EnneadTab Tailor.tab\\Proj. 2534.panel\\NYU HQ.pulldown\\monitor_area.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 2534.panel\\NYU HQ.pulldown\\monitor_area.pushbutton\\monitor_area_script.py",
        "tab": "Proj. 2534",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Proj. 2538.panel\\NYULI Kips Bay.pulldown\\load_color_template.pushbutton\\load_color_template_script.py": {
        "alias": "Load NYULI Kips Bay Color Template",
        "doc": "Update NYULI Kips Bay (Proj. 2538) Revit color schemes from the\nproject's color template Excel.\n\nSource:\nJ:\\2538\\2_Master File\\B-70_Programming\\04_Colors\\Color Scheme_NYULI Kips Bay.xlsx\n\nThe Excel uses the firm Ennead Healthcare dual-pair layout:\n    A: Department (full name)   B: Department Abbr.   C: Department Color\n    D: Program (full name)      E: Program Abbr.      F: Program Color\n\nFor Kips Bay specifically, only the \"CANCER CENTER\" worksheet is loaded;\nthe \"HEALTHCARE\" sheet is intentionally excluded per team decision\n(2026-05-20 -- the Kips Bay floor plates only use the Cancer Center\ncolor set, and HEALTHCARE + CANCER CENTER are meant to live in two\nindependent color schemes, never combined).\n\nLoaded targets:\n    department  ->  \"Department Type_Primary\"\n    program     ->  \"Program Type_Primary\"\n\nNOTE: full names from col A / col D are used as Revit entry names,\nNOT the abbreviations in col B / col E.\n\nMulti-sheet merge logic with conflict detection is preserved below in\ncase a future project needs it -- just add sheet names to SOURCE_SHEETS.\nWith a single sheet, no conflicts can fire by construction.\n",
        "icon": "EnneadTab Tailor.tab\\Proj. 2538.panel\\NYULI Kips Bay.pulldown\\load_color_template.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. 2538.panel\\NYULI Kips Bay.pulldown\\load_color_template.pushbutton\\load_color_template_script.py",
        "tab": "Proj. 2538",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Proj. Princeton.panel\\Proj. Princetong.pulldown\\fire_door_checker.pushbutton\\fire_door_checker_script.py": {
        "alias": "Fire Door Checker",
        "doc": "Find rated walls and doors in the model and highlight them in schedules.\n\nMain Steps:\n1. Locate all rated walls based on fire rating parameter\n2. Find doors hosted on rated walls\n3. Cross reference with door schedule\n4. Highlight rated doors in schedule by changing text color to red\n\nOptional:\n- Creates a report of findings\n- Allows for parameter verification\n",
        "icon": "EnneadTab Tailor.tab\\Proj. Princeton.panel\\Proj. Princetong.pulldown\\fire_door_checker.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Proj. Princeton.panel\\Proj. Princetong.pulldown\\fire_door_checker.pushbutton\\fire_door_checker_script.py",
        "tab": "Proj. Princeton",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Tester.panel\\associate_para.pushbutton\\associate_para_script.py": {
        "alias": "Associate Parameter To Family",
        "doc": "Associate parameters to family, to be fillfulled by Colin",
        "icon": "EnneadTab Tailor.tab\\Tester.panel\\associate_para.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab Tailor.tab\\Tester.panel\\associate_para.pushbutton\\associate_para_script.py",
        "tab": "Tester",
        "tab_icon": null
    },
    "EnneadTab Tailor.tab\\Tester.panel\\test_encoder_2025.pushbutton\\test_encoder_2025_script.py": {
        "alias": "Test Encoder 2025",
        "doc": "Confirm the keynote tools still load correctly on this build of Revit.\n\nA quick smoke test for the Tester panel. It loads the keynote and interop machinery\nthat the keynote buttons rely on and opens and closes an empty transaction. If the\nbutton finishes without an error, keynote support is healthy on this Revit version.\nNothing in your model is changed.",
