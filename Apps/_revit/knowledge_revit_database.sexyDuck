        "tab_icon": null
    },
    "EnneadTab.tab\\Manage.panel\\parameter_manager.pushbutton\\parameter_manager_script.py": {
        "alias": "Proj. Parameter Batch Adding",
        "doc": "Batch adding shared parameters to multiple project files. \nThis can reduce mistake during manual operation of repeating task.\n\nIf this shared parameter has been added before, it will not add again.\nNote that for Revit, the spelling is not important, the GUID is important.",
        "icon": "EnneadTab.tab\\Manage.panel\\parameter_manager.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Manage.panel\\parameter_manager.pushbutton\\parameter_manager_script.py",
