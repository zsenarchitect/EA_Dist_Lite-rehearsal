    "EnneadTab.tab\\ACE.panel\\AutoExporter.pushbutton\\revit_auto_export_script.py": {
        "alias": "Amazing Auto Export",
        "doc": "Export a scheduled set of sheets to PDF, DWG, and JPG without anyone at the keyboard.\n\nThe workhorse behind the firm's overnight exports. It opens the cloud model on its\nown, produces the sheet set in each requested format, drops the files in the agreed\nproject folder, tells the team the run is done, and closes Revit behind itself.\n\nFeatures:\n- PDF, DWG, and JPG produced in one pass over the sheet set\n- Runs unattended on a schedule, so the model is fresh each morning\n- A notification goes out when the export finishes or fails",
        "icon": "EnneadTab.tab\\ACE.panel\\AutoExporter.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\AutoExporter.pushbutton\\revit_auto_export_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\CollectTextures.pushbutton\\collect textures_script.py": {
        "alias": "Collect Textures",
        "doc": "Gather every material texture image into one folder and repoint the materials at it.\n\nRenders break when texture images live on someone's desktop. This copies the image\nbehind each material into a shared folder and updates the material to point at the\nnew copy, so the model renders the same on any machine.\n\nFeatures:\n- Runs across every material in the model\n- A progress bar shows the material being processed, and can be cancelled\n- The whole repoint is one undo step",
        "icon": "EnneadTab.tab\\ACE.panel\\CollectTextures.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\CollectTextures.pushbutton\\collect textures_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\ColorScheme.pulldown\\Excel2ColorScheme.pushbutton\\excel2color_scheme_script.py": {
        "alias": "Excel2ColorScheme",
        "doc": "Push colors edited in Excel back into a Revit color scheme.\n\nEdit your colors where it is comfortable, then bring them back in one step. Two\nworkflows are supported and the button asks which one your spreadsheet came from.\n\nFeatures:\n- Round-trip: for a spreadsheet you exported with ColorScheme2Excel, one scheme per file\n- Office template: for the standard Ennead sheet with Department and Program columns\n  side by side, which updates both schemes in one pass\n- Online: no Excel needed - pull the project's color book straight from enneadtab.com\n  (Department + Program), applied in one pass. Sign in once when prompted.\n\nUsage:\n1. Run the button and pick the source (Excel round-trip, Excel office template, or Online)\n2. For Excel: pick the file and scheme. For Online: enter the project number and sector.",
        "icon": "EnneadTab.tab\\ACE.panel\\ColorScheme.pulldown\\Excel2ColorScheme.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\ColorScheme.pulldown\\Excel2ColorScheme.pushbutton\\excel2color_scheme_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\ColorScheme.pulldown\\color_scheme_to_filled_region_types.pushbutton\\color_scheme_to_filled_region_types_script.py": {
        "alias": "ColorScheme To FilledRegion Types",
        "doc": "Turn a color scheme into filled region types so diagrams match your plan colors.\n\nPick a color scheme and every entry in it becomes a filled region type carrying that\nentry's exact color, ready to draw with. Existing types are refreshed rather than\nduplicated, so re-running after a color change keeps your diagrams in step with the\nplans.\n\nFeatures:\n- Each type is named after its scheme entry so it is easy to find in the type list\n- The whole conversion is one undo step\n\nUsage:\n1. Run the button and pick the color scheme to convert",
        "icon": "EnneadTab.tab\\ACE.panel\\ColorScheme.pulldown\\color_scheme_to_filled_region_types.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\ColorScheme.pulldown\\color_scheme_to_filled_region_types.pushbutton\\color_scheme_to_filled_region_types_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\ColorScheme.pulldown\\export_color_scheme.pushbutton\\export_color_scheme_script.py": {
        "alias": "ColorScheme2Excel",
        "doc": "Export any color scheme to Excel so the colors can be edited outside Revit.\n\nEvery entry in the scheme lands in a spreadsheet with its color, ready to hand to a\nconsultant or mark up yourself. Bring the edits back with Excel2ColorScheme.\n\nFeatures:\n- Export several schemes at once, each on its own worksheet\n- Choose whether to include entries that no element currently uses\n- The model is not changed; this only writes a spreadsheet\n\nUsage:\n1. Run the button and tick the schemes to export\n2. Say whether unused colors should be included",
        "icon": "EnneadTab.tab\\ACE.panel\\ColorScheme.pulldown\\export_color_scheme.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\ACE.panel\\ColorScheme.pulldown\\export_color_scheme.pushbutton\\export_color_scheme_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\ColorScheme.pulldown\\transfer_color_scheme.pushbutton\\transfer_color_scheme_script.py": {
        "alias": "Transfer Color Scheme",
        "doc": "Copy every entry, color, and fill pattern from one color scheme onto another.\n\nSaves rebuilding a scheme by hand when a second one needs to look the same. Entries\nmissing from the destination are added; where an entry already exists you are asked\nbefore its color is overwritten.\n\nFeatures:\n- The two schemes must cover the same category, and you are told if they do not\n- A summary lists what was added and what was overwritten\n- The transfer is one undo step\n\nUsage:\n1. Run the button and pick the scheme to copy from, then the one to copy onto",
        "icon": "EnneadTab.tab\\ACE.panel\\ColorScheme.pulldown\\transfer_color_scheme.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\ColorScheme.pulldown\\transfer_color_scheme.pushbutton\\transfer_color_scheme_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\Excel Sheet Creator.pulldown\\excel_sheet_creator.pushbutton\\excel_sheet_creator_script.py": {
        "alias": "Create Sheets By Excel",
        "doc": "Create new sheets based on data from Excel.\nIf you need help on what kind of Excel to prepare, you can open a sample excel and begin from there.",
        "icon": "EnneadTab.tab\\ACE.panel\\Excel Sheet Creator.pulldown\\excel_sheet_creator.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\ACE.panel\\Excel Sheet Creator.pulldown\\excel_sheet_creator.pushbutton\\excel_sheet_creator_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\Excel Sheet Creator.pulldown\\open_sample_excel.pushbutton\\open_sample_excel_script.py": {
        "alias": "Open Sample Excel",
        "doc": "Get a sample excel to fill out data in similar format.\nUsing those format will make it easy to generate dummy sheets in Revit.\nPlease note that Chinese translation will require special care when saving excel format.",
        "icon": "EnneadTab.tab\\ACE.panel\\Excel Sheet Creator.pulldown\\open_sample_excel.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\Excel Sheet Creator.pulldown\\open_sample_excel.pushbutton\\open_sample_excel_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\Family.pulldown\\Family RePath.pushbutton\\family repath_script.py": {
        "alias": "Family RePath",
        "doc": "Save the project's families out to a folder of your choice, sorted by category.\n\nPulls the families you pick out of the model, files them into category subfolders in\nthe folder you name, and loads the tidied copies back into the model. The result is\none clean, findable family library instead of paths scattered across desktops.\n\nFeatures:\n- Families are grouped into subfolders by their Revit category\n- Optionally reach into nested families and save those out too\n- Optionally sync and close the model when the reload is done, so you can walk away\n\nUsage:\n1. Run the button and tick the families to save out\n2. Pick the destination folder\n3. Choose whether to include nested families and whether to sync and close afterwards",
        "icon": "EnneadTab.tab\\ACE.panel\\Family.pulldown\\Family RePath.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\ACE.panel\\Family.pulldown\\Family RePath.pushbutton\\family repath_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\Family.pulldown\\batch_fix_family_name.pushbutton\\batch_fix_family_name_script.py": {
        "alias": "Batch Format Family Name",
        "doc": "Batch rename family names to the Healthcare standard convention.\n\nFormat: CATEGORY_MainDescription_FIRM[_AdditionalInfo][_HOSTING]\n\nEdit the components inline in the grid, check the families to fix, and\nApply. Analysis and naming-rules helpers are one click away.",
        "icon": "EnneadTab.tab\\ACE.panel\\Family.pulldown\\batch_fix_family_name.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\Family.pulldown\\batch_fix_family_name.pushbutton\\batch_fix_family_name_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\Family.pulldown\\change_family_category.pushbutton\\change_family_category_script.py": {
        "alias": "Change Family Category",
        "doc": "Batch change family categories with user-friendly interface and comprehensive reporting.",
        "icon": "EnneadTab.tab\\ACE.panel\\Family.pulldown\\change_family_category.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\Family.pulldown\\change_family_category.pushbutton\\change_family_category_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\Family.pulldown\\cleanup_family.pushbutton\\cleanup_family_script.py": {
        "alias": "CleanUp Family",
        "doc": "Slim down the families you pick by purging what is unused inside them.\n\nBloated families make a model slow to open and heavy to sync. This opens each family\nyou select, throws out the unused types, materials, and imports hiding inside, then\nreloads the lighter version into the project.\n\nFeatures:\n- Nested families are cleaned too, all the way down\n- Optionally set every cleaned family to consistent metric or imperial units\n- A summary reports what came out of each family\n\nUsage:\n1. Run the button and tick the families to clean\n2. Choose whether to standardize units\n3. Review the summary when the reload finishes",
        "icon": "EnneadTab.tab\\ACE.panel\\Family.pulldown\\cleanup_family.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\Family.pulldown\\cleanup_family.pushbutton\\cleanup_family_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\Family.pulldown\\family_tree.pushbutton\\family_tree_script.py": {
        "alias": "Family Tree",
        "doc": "See what is nested inside your families as an interactive tree in your browser.\n\nDraws the whole parent and child chain of a family so you can finally see what is\nburied inside it, and click any node to read its parameters. Handy before cleaning\nor repathing a family you did not build.\n\nFeatures:\n- Works from a project or from inside an open family\n- Click through the tree to expand and collapse each level\n- Nothing in the model is changed; the tree is only a view of it",
        "icon": "EnneadTab.tab\\ACE.panel\\Family.pulldown\\family_tree.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\Family.pulldown\\family_tree.pushbutton\\family_tree_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\Family.pulldown\\list_family.pushbutton\\list_family_script.py": {
        "alias": "List Families",
        "doc": "Lists selected families in organized views.\n\nThis script allows listing of both 2D detail items and 3D families in dedicated views.\nDetail items are placed in a drafting view while 3D families can be placed in either\na 3D view or floor plan view. Families are organized by category with labels and optional tags.\n\nKey Features:\n- Supports both 2D detail items and 3D families\n- Organizes families by category with clear labeling\n- Creates dedicated views for family display\n- Optional tagging support\n- Handles hosted families with appropriate host elements\n- Creates category-specific filtered views\n\nNote: \n3D families will be visible in all project views. The script creates an internal level \nfar from the main project levels to minimize interference.\n",
        "icon": "EnneadTab.tab\\ACE.panel\\Family.pulldown\\list_family.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\Family.pulldown\\list_family.pushbutton\\list_family_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\Family.pulldown\\rename_nesting_family.pushbutton\\rename_nesting_family_script.py": {
        "alias": "Rename Nesting Family",
        "doc": "Strip the conflicting-name tag Revit leaves on nested families after a bad load.\n\nWhen two families collide on load, Revit quietly renames the nested one and leaves an\nugly marker in its name. This finds every nested family carrying that marker, cleans\nthe name back up, and reloads the corrected family into the project.\n\nFeatures:\n- Every family in the project is checked, including the ones nested inside them\n- Families you cannot edit are skipped\n- A log lists every rename that was made\n\nUsage:\n1. Run the button and let it work through the families\n2. Review the list of renames in the output window",
        "icon": "EnneadTab.tab\\ACE.panel\\Family.pulldown\\rename_nesting_family.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\ACE.panel\\Family.pulldown\\rename_nesting_family.pushbutton\\rename_nesting_family_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\Family.pulldown\\rename_parameter.pushbutton\\rename_parameter_script.py": {
        "alias": "Rename Parameters",
        "doc": "Rename family parameters without losing the values already set in the project.\n\nRenaming a parameter by hand normally wipes whatever every instance had in it. This\ncarries the values across, so schedules, tags, and filters keep reading the same\nnumbers under the new name.\n\nFeatures:\n- Rename several parameters in one pass from a single dialog\n- The dialog stays open so you can keep working in the model beside it\n- Values are read back and re-applied after the rename\n\nUsage:\n1. Run the button and pick the family to work on\n2. Type the new name beside each parameter you want changed\n3. Apply, and check the values survived in a schedule",
        "icon": "EnneadTab.tab\\ACE.panel\\Family.pulldown\\rename_parameter.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\Family.pulldown\\rename_parameter.pushbutton\\rename_parameter_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\List_Legend and Schedule.pushbutton\\list schedule and legend_script.py": {
        "alias": "Legend&Schedule Where?",
        "doc": "Which Legand and Schedule were used? Where are they?\nIf you have been wondering about those question, this tool can help you with it.\n\nIt list all the current locations for the schedules and legend, with a clickable link!",
        "icon": "EnneadTab.tab\\ACE.panel\\List_Legend and Schedule.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\ACE.panel\\List_Legend and Schedule.pushbutton\\list schedule and legend_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\Project Starter.pushbutton\\project_starter_script.py": {
        "alias": "Project Initiating",
        "doc": "Set up a brand new project in one window instead of a dozen separate dialogs.\n\nEverything you normally do by hand on day one of a model, gathered in one place. The\nwindow stays open beside the model so you can work through the setup at your own pace.\n\nFeatures:\n- Create the office standard worksets in one click\n- Build levels from a grid you fill in\n- Create the whole sheet set from a spreadsheet\n- Fill in the project information fields quickly",
        "icon": "EnneadTab.tab\\ACE.panel\\Project Starter.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\Project Starter.pushbutton\\project_starter_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\QAQC_AI.pushbutton\\qaqc_ai_UI_script.py": {
        "alias": "QAQC Reporter",
        "doc": "Produce a health report on the model and ask questions about it in plain English.\n\nRuns the firm's quality checks over the open model and gathers the results into one\nreport. Instead of scrolling it, you can just ask: what are the critical issues, is\nthis model ready to issue, which worksets are a mess. Good before a milestone or a\ncoordination review.\n\nFeatures:\n- Ask follow-up questions in plain English and get answers from the report\n- The window stays open beside the model so you can fix issues as you read\n- Nothing in the model is changed; this is a read-only review",
        "icon": "EnneadTab.tab\\ACE.panel\\QAQC_AI.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\ACE.panel\\QAQC_AI.pushbutton\\qaqc_ai_UI_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\Worksets.pulldown\\create 3D view of workset.pushbutton\\3d workset view_script.py": {
        "alias": "3D Workset Views",
        "doc": "Create 3D workset checking view in your working folder.\nEach workset will get a 3D view that only have this workset turned on.\n\nIf there are no 'Views_$Group' and 'Views_$Series' in the view parameter, such as the case in using other firm file setup, the tool will not introduce 'Views_$Group' and 'Views_$Series' to them, the new 3D workset views will be just using revit default '???' group.",
        "icon": "EnneadTab.tab\\ACE.panel\\Worksets.pulldown\\create 3D view of workset.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\ACE.panel\\Worksets.pulldown\\create 3D view of workset.pushbutton\\3d workset view_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\Worksets.pulldown\\create_worksets.pushbutton\\create_worksets_script.py": {
        "alias": "Create Worksets",
        "doc": "Create Worksets following the standard Ennead Workset Structure.\nYou can the options to create any or all from below:",
        "icon": "EnneadTab.tab\\ACE.panel\\Worksets.pulldown\\create_worksets.pushbutton\\icon.png",
