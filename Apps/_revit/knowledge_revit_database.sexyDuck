        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\check_formula.pushbutton\\check_formula_script.py": {
        "alias": "Inspect Excel Formula",
        "doc": "Reveal the hidden formulas in a spreadsheet before you trust its numbers.\n\nA cell that looks like a plain number may be a formula pointing somewhere else. This\nlists every formula in the worksheet you pick and marks those cells with a dashed\nborder in a local copy, so you can see at a glance which numbers are calculated and\nwhich were typed. Worth doing before importing consultant data into Revit.\n\nFeatures:\n- Your original spreadsheet is not modified; the marked-up copy is a separate file\n- Every formula is printed to the output window\n\nUsage:\n1. Run the button and pick the Excel file\n2. Pick the worksheet to inspect",
        "icon": "EnneadTab.tab\\ACE.panel\\check_formula.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\ACE.panel\\check_formula.pushbutton\\check_formula_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\check_phase_mapping.pushbutton\\check_phase_mapping_script.py": {
        "alias": "Check Phase Mapping",
        "doc": "Get the phase mapping of mutiple documents.",
        "icon": "EnneadTab.tab\\ACE.panel\\check_phase_mapping.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\ACE.panel\\check_phase_mapping.pushbutton\\check_phase_mapping_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\check_view_link.pushbutton\\check_view_link_script.py": {
        "alias": "Check Linked-View Relationship",
        "doc": "Report which views depend on which, so you know what breaks before you delete one.\n\nViews quietly reference each other through dependents and callouts. This lists every\none of those relationships, so you can see why a view is showing something you did not\nexpect, and what would go with it if you deleted it.\n\nFeatures:\n- Circular references between views are called out\n- Nothing in the model is changed; this is a read-only check",
        "icon": "EnneadTab.tab\\ACE.panel\\check_view_link.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\check_view_link.pushbutton\\check_view_link_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\duplicate_area_scheme.pushbutton\\duplicate_area_scheme_script.py": {
        "alias": "Duplicate Area Scheme",
        "doc": "Duplicates a Revit area scheme to a new area scheme with all boundaries and areas.\n\nThis tool allows you to:\n1. Select an existing area scheme to duplicate\n2. Provide a new unique name for the duplicated scheme\n3. Choose which views to include in the duplication process\n4. Automatically transfer all boundaries and areas to the new scheme\n",
        "icon": "EnneadTab.tab\\ACE.panel\\duplicate_area_scheme.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\duplicate_area_scheme.pushbutton\\duplicate_area_scheme_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\export_filled_region_types.pushbutton\\export_filled_region_types_script.py": {
        "alias": "Export Filled Region Types",
        "doc": "Export the filled region color setting to excel so you can use it elsewhere.",
        "icon": "EnneadTab.tab\\ACE.panel\\export_filled_region_types.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\ACE.panel\\export_filled_region_types.pushbutton\\export_filled_region_types_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\get_model_guids.pushbutton\\get_model_guids_script.py": {
        "alias": "Get Model GUIDs",
        "doc": "Read out the cloud identifiers of the open model so it can be added to Auto Export.\n\nSetting a model up for overnight export needs two identifiers that Revit does not show\nanywhere in its interface. Run this from the open cloud model and both are printed,\nready to copy into the Auto Export setup.\n\nFeatures:\n- The cloud region is reported alongside the identifiers\n- You are told plainly if the open model is not a cloud model\n- Nothing in the model is changed",
        "icon": "EnneadTab.tab\\ACE.panel\\get_model_guids.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\get_model_guids.pushbutton\\get_model_guids_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\inspect_local_graphic_override.pushbutton\\inspect_local_graphic_override_script.py": {
        "alias": "Inspect Local Graphic Override",
        "doc": "Find the views where someone has overridden graphics by hand instead of by template.\n\nLocal overrides and hand-hidden elements are invisible until a drawing prints wrong.\nThis walks the views on the sheets you pick and reports every override and hidden\nelement that the view template does not control, so you can put the view back under\ntemplate control.\n\nFeatures:\n- Read the findings in Revit, or export them for review in Excel\n- Nothing in the model is changed; this is a read-only audit\n\nUsage:\n1. Run the button and pick the sheets whose views you want checked\n2. Choose whether to review in Revit or export the list",
        "icon": "EnneadTab.tab\\ACE.panel\\inspect_local_graphic_override.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\ACE.panel\\inspect_local_graphic_override.pushbutton\\inspect_local_graphic_override_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\keynote_assistant.pushbutton\\keynote_assistant_script.py": {
        "alias": "Keynote Assistant",
        "doc": "Manage the whole project keynote list from one searchable window.\n\nAdd, edit, and reorganize keynotes without hunting through the keynote text file.\nSearch the whole list, move keynotes between categories, and edit many at once\ninstead of one at a time.\n\nFeatures:\n- Search across every keynote in the project\n- Reorganize keynotes into categories by dragging\n- Edit or retire a batch of keynotes in one go\n- Translate keynote text for international project teams",
        "icon": "EnneadTab.tab\\ACE.panel\\keynote_assistant.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\ACE.panel\\keynote_assistant.pushbutton\\keynote_assistant_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\lines_in_view_locator.pushbutton\\lines_in_view_locator_script.py": {
        "alias": "Lines-In-View Locator",
        "doc": "Rank the views hoarding the most drafting and model lines, worst offenders first.\n\nA model that has grown slow is usually carrying a few views stuffed with hand-drawn\nlines. This counts them and ranks the views, so you know exactly where to go and what\nto clean up.\n\nFeatures:\n- Detail lines and model lines are reported separately\n- Each line's workset is listed so you can trace who owns the mess\n- Nothing in the model is changed; this is a read-only report",
        "icon": "EnneadTab.tab\\ACE.panel\\lines_in_view_locator.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\lines_in_view_locator.pushbutton\\lines_in_view_locator_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\merge_ost.pushbutton\\merge_ost_script.py": {
        "alias": "Merge Object Style",
        "doc": "Merge duplicate object styles (subcategories) into a single target.\n\nSolves the 'boomerang' problem where deleted subcategories reappear because\nfamilies still carry them internally.\n\nWorkflow:\n  1. Pick the bad subcategory to remove and the target to keep.\n  2. Dry-delete the bad subcategory (rolled back) to discover every\n     family and project element that references it.\n  3. Open each affected family (loadable and in-place), reassign\n     geometry from bad to target subcategory, delete the bad one,\n     and load the family back.\n  4. Reassign project-level elements (detail lines, filled regions, etc.)\n     and delete the bad subcategory from the project.\n\nNote: Category.Name is read-only in the Revit API so subcategories\ncannot be renamed directly; elements must be reassigned instead.\n",
        "icon": "EnneadTab.tab\\ACE.panel\\merge_ost.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\merge_ost.pushbutton\\merge_ost_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\monitor_link_status.pushbutton\\monitor_link_status_script.py": {
        "alias": "Monitor Link Status",
        "doc": "Monitor and compare grid and level elements between current document and linked documents.\nThis tool helps track differences in grids and levels between the host document and its linked models.\nIt identifies elements that exist in one document but not in others, and checks monitoring status.",
        "icon": "EnneadTab.tab\\ACE.panel\\monitor_link_status.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\monitor_link_status.pushbutton\\monitor_link_status_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\open_keynote_exporter.pushbutton\\open_keynote_exporter_script.py": {
        "alias": "Open Keynote Exporter",
        "doc": "Open the Keynote Exporter -- now a standalone web service.\n\nThe Keynote Exporter has been extracted from EnneadTab-OS into its own product at\nhttps://enneadtab.com/keynote-exporter. This button opens it in your browser; the old\nbundled .exe was retired to shrink the repo. Revit stays open and your model is untouched.",
        "icon": "EnneadTab.tab\\ACE.panel\\open_keynote_exporter.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\open_keynote_exporter.pushbutton\\open_keynote_exporter_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\property_line_from_excel.pushbutton\\property_line_from_excel_script.py": {
        "alias": "Property Line From Excel",
        "doc": "Generate detail line from the Excel survey pt data. Best used for property line geneation.",
        "icon": "EnneadTab.tab\\ACE.panel\\property_line_from_excel.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\property_line_from_excel.pushbutton\\property_line_from_excel_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\relationship_diagram.pushbutton\\relationship_diagram_script.py": {
        "alias": "Relationship Diagram",
        "doc": "Interactive convas to draw relationship diagram.",
        "icon": "EnneadTab.tab\\ACE.panel\\relationship_diagram.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\relationship_diagram.pushbutton\\relationship_diagram_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\repath_dwg_drive_letter.pushbutton\\repath_dwg_drive_letter_script.py": {
        "alias": "Repath Dwg Drive Letter",
        "doc": "Pick the old and new drive letters to repath all linked DWGs.",
        "icon": "EnneadTab.tab\\ACE.panel\\repath_dwg_drive_letter.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\repath_dwg_drive_letter.pushbutton\\repath_dwg_drive_letter_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\revision_cloud_color_manager.pushbutton\\revision_cloud_color_manager_script.py": {
        "alias": "Revision Cloud Color Manager",
        "doc": "Give each revision its own cloud color so revisions read apart at a glance.\n\nEvery revision cloud in the model looks the same until you color them. This assigns a\ndistinct color per revision, so a sheet carrying three revisions tells its own story.\n\nFeatures:\n- A ready-made color palette, or pick your own color per revision\n- Turn the coloring on for review and off again before issue\n- Your color choices are remembered and reused on the next model\n\nUsage:\n1. Run the button and set a color against each revision\n2. Turn coloring on to review, and off when you are done",
        "icon": "EnneadTab.tab\\ACE.panel\\revision_cloud_color_manager.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\ACE.panel\\revision_cloud_color_manager.pushbutton\\revision_cloud_color_manager_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\sheet_tree.pushbutton\\sheet_tree_script.py": {
        "alias": "View Reference Tree",
        "doc": "Map how your sheets and views reference each other, and open the map to explore.\n\nFollows every callout, section, and elevation marker to build a picture of which view\npoints at which. Use it to find orphan views, trace where a detail is called up from,\nor see the shape of the drawing set before an issue.\n\nFeatures:\n- Covers every sheet and every view placed on them\n- Nothing in the model is changed; the map is only a view of it",
        "icon": "EnneadTab.tab\\ACE.panel\\sheet_tree.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\sheet_tree.pushbutton\\sheet_tree_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\smart_egress_path.pushbutton\\smart_egress_path_script.py": {
        "alias": "Smart Egress Path",
        "doc": "Draw egress paths whose travel distance and tags update themselves as the plan changes.\n\nEach path is placed as a tagged marker with its travel distance read straight off the\ngeometry, so when a wall moves the distance on the drawing moves with it. No more\nre-measuring routes by hand every time the plan shifts.\n\nFeatures:\n- The path marker and tag families are loaded for you if they are missing\n- An egress path schedule is created so every route can be checked in one table\n- Distances stay correct as the design evolves, ready for the code review",
        "icon": "EnneadTab.tab\\ACE.panel\\smart_egress_path.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\ACE.panel\\smart_egress_path.pushbutton\\smart_egress_path_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\smart_match_grid_extend.pushbutton\\smart_match_grid_extend_script.py": {
        "alias": "Smart Match Grid Extend",
        "doc": "Match grid bubbles and extents across every plan to a reference view you nominate.\n\nGrid bubbles drift out of step view by view until no two plans agree. Pick the view\nthat is right, and every other floor plan and area plan is brought into line: the same\nbubbles shown, the same ends hidden, the same extents.\n\nFeatures:\n- Covers every floor plan and area plan in the model\n- Each grid end is matched independently, so half-shown grids stay half-shown\n- The whole match is one undo step\n\nUsage:\n1. Run the button and nominate the reference view whose grids are correct\n2. Let it work through the remaining plans",
        "icon": "EnneadTab.tab\\ACE.panel\\smart_match_grid_extend.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\ACE.panel\\smart_match_grid_extend.pushbutton\\smart_match_grid_extend_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\transfer_parameter_data.pushbutton\\transfer_parameter_data_script.py": {
        "alias": "Transfer Parameter Data",
        "doc": "Transfer some data from one parameter to another. \nWhen you inherated from older file some parameter is carried over and now you have duplcated parameter container. \nUse this to cleanup the parameter panel",
        "icon": "EnneadTab.tab\\ACE.panel\\transfer_parameter_data.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\ACE.panel\\transfer_parameter_data.pushbutton\\transfer_parameter_data_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\update_DOB_page.pushbutton\\update_DOB_page_script.py": {
        "alias": "Update DOB Page Number",
        "doc": "For DOB submission in NYC there reuqires a page number on the titleblock.",
        "icon": "EnneadTab.tab\\ACE.panel\\update_DOB_page.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\update_DOB_page.pushbutton\\update_DOB_page_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\visulize_door_room_calc_pt.pushbutton\\visulize_door_room_calc_pt_script.py": {
        "alias": "Door Calc Pt Visualizer",
        "doc": "Draw detail lines from each door to its room calculation points in the views you pick.\n\nMakes it obvious which rooms a door is reporting to and from, so doors that feed\nthe wrong room in a schedule stand out instead of hiding in the numbers.\n\nFeatures:\n- Blue lines run to the To Room, red lines run to the From Room\n- Doors that carry no calculation points are counted and skipped\n- Summary of processed doors printed when it finishes",
        "icon": "EnneadTab.tab\\ACE.panel\\visulize_door_room_calc_pt.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\ACE.panel\\visulize_door_room_calc_pt.pushbutton\\visulize_door_room_calc_pt_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\ACE.panel\\wall_type_diagram.pushbutton\\wall_type_diagram_script.py": {
        "alias": "Wall Type Diagram",
        "doc": "Create a wall type legend and matching view filters, one color per wall type.\n\nEach wall type takes its color from the filled region type already associated\nwith it; when there is none, a fresh color is picked for you. The filters can be\npushed onto a view template so every plan reads the same way.\n\nFeatures:\n- Legend view with a color box and label for each selected wall type\n- One view filter per wall type, with a consistent color override\n- Optional apply to a view template you choose",
        "icon": "EnneadTab.tab\\ACE.panel\\wall_type_diagram.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\ACE.panel\\wall_type_diagram.pushbutton\\wall_type_diagram_script.py",
        "tab": "ACE",
        "tab_icon": null
    },
    "EnneadTab.tab\\Import Export.panel\\DWG export setting.pushbutton\\export setting_script.py": {
        "alias": "DWG Export Update Layer",
        "doc": "Randomize the layer color, and rename the layer to to format below:\n    Category_SubCategory\n    \nThis tool does not change other existing setting for this export setting.\nIt makes life in Rhino easier after exporting contents over.",
        "icon": "EnneadTab.tab\\Import Export.panel\\DWG export setting.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Import Export.panel\\DWG export setting.pushbutton\\export setting_script.py",
        "tab": "Import Export",
        "tab_icon": null
    },
    "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\Rhino2Revit_UI.pushbutton\\Rhino2Revit_UI_script.py": {
        "alias": "Rhino2Revit(For Full Control)",
        "doc": "Convert .3dm and .dwg files into native Revit family elements.\nCompared to shape2family and block2family, this tool give you the maximual control over subCategory mapping to existing category so you revit will be the most clean.\nPair this usage with move2origin.\n\n\nKey Features:\n- Assign subcategories per file\n- Add new subcategories on the fly\n- Use source filename as subcategory\n- Support major curve conversion (except NURBS curves with control points on different CPlanes)\n\nBest used with EnneadTab for Rhino's Rhino2Revit exporter window.\n\nFormat Support:\n.3dm Files:\n- Stable conversion to native Revit elements\n- Individual control of Boolean, Subcategory, Visibility, Dimensions\n- Requires clean source models\n\n.dwg Files:\n- More tolerant of model imperfections\n- Handles lines, arcs, circles and planar NURBS curves\n- Elements from same source file are grouped\n- Creates Import subcategories (auto-cleaned)\n",
        "icon": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\Rhino2Revit_UI.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\Rhino2Revit_UI.pushbutton\\Rhino2Revit_UI_script.py",
        "tab": "Import Export",
        "tab_icon": null
    },
    "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\bigrhino2revit.pushbutton\\bigrhino2revit_script.py": {
        "alias": "BigRhino2Revit(For Large Batch)",
        "doc": "Convert recent Rhino2Revit output jobs into Revit families and load them into the project.\n\nThis tool processes all recent output jobs from Rhino2Revit in Rhino and:\n1. Creates new generic families from template\n2. Converts job files to Revit elements using filename as subcategory\n3. Saves families to temp location and loads into main project\n4. Moves newly loaded families to origin point\n\n\n",
        "icon": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\bigrhino2revit.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\bigrhino2revit.pushbutton\\bigrhino2revit_script.py",
        "tab": "Import Export",
        "tab_icon": null
    },
    "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\block2family.pushbutton\\block2family_script.py": {
        "alias": "Block2Family",
        "doc": "Converts Rhino blocks to Revit families.\n\nThis script processes block data exported from Rhino to create or update corresponding families in Revit.\nKey features:\n- Creates new families from Rhino block geometry\n- Updates existing family instances\n- Handles transformations (move/rotate) by removing old instances and creating new ones\n- Preserves block parameters as family parameters\n- Supports both UV projection (flat-modeled) and standing geometry\n- Maintains Rhino block IDs for tracking\n\nInput: .internal data files containing block data from Rhino\nOutput: Revit family instances with matching geometry and parameters\n",
        "icon": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\block2family.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\block2family.pushbutton\\block2family_script.py",
        "tab": "Import Export",
        "tab_icon": null
    },
    "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\brep2mass.pushbutton\\brep2mass_script.py": {
        "alias": "Brep2Mass",
        "doc": "Rebuild breps exported from Rhino as native Revit mass geometry.\n\nThe shapes come back as real Revit forms you can host, schedule, and cut in\nsection, instead of a dumb import you cannot work with.\n\nUsage:\n1. In Rhino, export the breps with EnneadTab for Rhino\n2. Run this button and confirm the unit the Rhino file was drawn in",
        "icon": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\brep2mass.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\brep2mass.pushbutton\\brep2mass_script.py",
        "tab": "Import Export",
        "tab_icon": null
    },
    "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\import Rhino camera.pushbutton\\import_rhino_camera_script.py": {
        "alias": "Import Rhino Camera",
        "doc": "Work with Camera exported in Rhino side to recreate the same perspective camera.\n\nIt can be useful for Enscape view recreation in Revit.",
        "icon": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\import Rhino camera.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\import Rhino camera.pushbutton\\import_rhino_camera_script.py",
        "tab": "Import Export",
        "tab_icon": null
    },
    "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\import_rhino_material.pushbutton\\import_rhino_material_script.py": {
        "alias": "Import Rhino Material",
        "doc": "Bring Rhino material definitions into Revit as new or refreshed Revit materials.\n\nMaterials that already exist in the project keep their identity and simply pick\nup the incoming color; the ones that are missing are created for you, so a Rhino\nmodel and a Revit model can be kept looking like the same building.\n\nUsage:\n1. Export the materials from Rhino with EnneadTab for Rhino\n2. Run this button and review what was created versus updated",
        "icon": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\import_rhino_material.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\import_rhino_material.pushbutton\\import_rhino_material_script.py",
        "tab": "Import Export",
        "tab_icon": null
    },
    "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\map_Rhino_block.pushbutton\\map_rhino_block_script.py": {
        "alias": "Map Rhino Block to Revit Family",
        "doc": "Place Revit families at the position and orientation of matching Rhino blocks.\n\nEach Rhino block is matched to a Revit family type of the same name. The placed\ninstance is no longer stuck being a level-based, vertical-up family: it can sit\nin any freeform orientation, exactly as it did in Rhino.\n\nUsage:\n1. Export the blocks from Rhino with EnneadTab for Rhino\n2. Run this button and confirm the unit the Rhino file was drawn in\n3. Blocks with no family type of the same name are listed in the output",
        "icon": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\map_Rhino_block.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\map_Rhino_block.pushbutton\\map_rhino_block_script.py",
        "tab": "Import Export",
        "tab_icon": null
    },
    "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\move_to_origin.pushbutton\\move2origin_script.py": {
        "alias": "Move2Origin",
        "doc": "Move family instances to the internal origin while maintaining current orientation.\n\nThree operation modes are available:\n1: Family is placed in 3D view with incorrect location - Select it and move it.\n2: Family is placed somewhere in 3D view but location unknown - Select from listbox and move it.\n3: Family is newly loaded but not yet placed - Select from list and place at origin.\n\nNote: Some element types have location constraints and may not be movable to absolute origin.\nReport any issues to the EnneadTab team.\n",
        "icon": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\move_to_origin.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\move_to_origin.pushbutton\\move2origin_script.py",
        "tab": "Import Export",
        "tab_icon": null
    },
    "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\revit2rhino.pushbutton\\revit2rhino_script.py": {
        "alias": "Revit2Rhino",
        "doc": "\nScript for exporting Revit Family Instances to Rhino.\nIt converts each FamilyInstance's geometry into a Rhino block containing all its Breps\n(or fallback Meshes). \n\nBlock names in Rhino follow the format: \"FamilyName_TypeName\"\nEach export includes a timestamp in the filename.\n",
        "icon": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\revit2rhino.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\revit2rhino.pushbutton\\revit2rhino_script.py",
        "tab": "Import Export",
        "tab_icon": null
    },
    "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\rhino_draft_UI.pushbutton\\rhino_draft_UI_script.py": {
        "alias": "Rhino Drafter",
        "doc": "Draft curves and surfaces in Rhino and bring them into the current Revit view.\n\nCurves arrive as detail lines and surfaces arrive as filled regions, so awkward\n2D geometry can be shaped where it is easy to shape and finished where it needs\nto live. Rhino units are converted for you.\n\nFeatures:\n- Curves can also land as area boundary lines or room separation lines\n- Works in plan views and in elevation views\n- Round trip as many times as you need without retracing anything",
        "icon": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\rhino_draft_UI.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\rhino_draft_UI.pushbutton\\rhino_draft_UI_script.py",
        "tab": "Import Export",
        "tab_icon": null
    },
    "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\room2diagram.pushbutton\\room2diagram_script.py": {
        "alias": "RoomOrArea2Diagram",
        "doc": "Export Revit Rooms/Areas to Rhino as color-coded diagrams with XAML GUI.\n\nThis tool creates a simplified diagram representation of Rooms or Areas in Rhino:\n- Exports boundaries with filleted corners and optional inner offset\n- Maintains color coding from Revit color schemes\n- Adds text labels for space identifiers\n- Creates solid hatches for each space\n- Features XAML GUI with persistent settings\n- Supports both Rooms and Areas export\n- Configurable corner fillet radius and inner offset distance\n- Automatic settings save/restore for future use\n- Framework ready for drafting view group export (future feature)\n",
        "icon": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\room2diagram.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\room2diagram.pushbutton\\room2diagram_script.py",
        "tab": "Import Export",
        "tab_icon": null
    },
    "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\shape2family.pushbutton\\shape2family_script.py": {
        "alias": "Shape2Family",
        "doc": "This is to handle all the incoming geometry made from Rhino's shape2revit command.",
        "icon": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\shape2family.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\shape2family.pushbutton\\shape2family_script.py",
        "tab": "Import Export",
        "tab_icon": null
    },
    "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\srf2adp.pushbutton\\srf2adp_script.py": {
        "alias": "Srf2Adp",
        "doc": "Turn surfaces drawn in Rhino into placed Revit adaptive components.\n\nPick the adaptive family and type to use, and each incoming surface is built from\nits corner points. Set the corner order in Rhino first so the adaptive points\nland where you expect them to.\n\nUsage:\n1. In Rhino, set the adaptive corner sequence and export the surfaces\n2. Run this button, pick the family and type, and confirm the file unit",
        "icon": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\srf2adp.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Import Export.panel\\Rhino.pulldown\\srf2adp.pushbutton\\srf2adp_script.py",
        "tab": "Import Export",
        "tab_icon": null
    },
    "EnneadTab.tab\\Import Export.panel\\apply_doh_sheet_number.pushbutton\\apply_doh_sheet_number_script.py": {
        "alias": "Apply DOH SheetNum",
        "doc": "Toggle live sheet numbers between the firm Internal scheme and the client DOH scheme.\n\nBoth schemes are stored permanently, so nothing is lost when you switch.\nApplying a scheme copies the stored numbers into the live sheet number slot.",
        "icon": "EnneadTab.tab\\Import Export.panel\\apply_doh_sheet_number.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Import Export.panel\\apply_doh_sheet_number.pushbutton\\apply_doh_sheet_number_script.py",
        "tab": "Import Export",
        "tab_icon": null
    },
    "EnneadTab.tab\\Import Export.panel\\content_transfer.pushbutton\\content_transfer_script.py": {
        "alias": "Content Transfer",
        "doc": "Copy selected view templates, object styles, and materials between open models.\n\nUnlike Transfer Project Standards, you choose exactly which items travel instead\nof swallowing a whole category. When a name already exists in the destination you\ncan keep the destination version rather than overwrite it.\n\nUsage:\n1. Open both the source model and the destination model\n2. Run the button, pick the source model, then tick the items to send\n3. Review what transferred in the output window",
        "icon": "EnneadTab.tab\\Import Export.panel\\content_transfer.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Import Export.panel\\content_transfer.pushbutton\\content_transfer_script.py",
        "tab": "Import Export",
        "tab_icon": null
    },
    "EnneadTab.tab\\Import Export.panel\\ennead_exporter.pushbutton\\super_exporter_script.py": {
        "alias": "Ennead Exporter",
        "doc": "Export sheets to PDF, DWG, and JPG in one pass with consistent names and folders.\n\nSet the issue up once and the exporter handles the rest: file names built from\nthe prefix you choose, a folder per format, color or black and white, and only\nthe sheets carrying the revision you are issuing.\n\nFeatures:\n- Preview every output file name before a single file is written\n- Time estimate so you know whether to go get a coffee\n- Optional sync before exporting, and an email notification when it finishes",
        "icon": "EnneadTab.tab\\Import Export.panel\\ennead_exporter.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Import Export.panel\\ennead_exporter.pushbutton\\super_exporter_script.py",
        "tab": "Import Export",
        "tab_icon": null
    },
    "EnneadTab.tab\\Import Export.panel\\ennead_printer.bad_pushbutton\\OLD_ennead_printer_script.py": {
        "alias": "Ennead Exporter",
        "doc": "A great helper for your print on deadline. Feastures include:\n  -pdf, dwg, jpg export together\n  -Package export files to subfolders in destination folder by assigned prefix and file type\n  -Prefix for auto numbering\n  -Email result as a link to folder.\n  -Time esitmation, with increasing accuracy the more you export\n  -Identify color setting per parameter on sheet. So you can mix color and BW export together.\n  -Option to sync and close files after exporting done.\n  -Export sheets by revision mark instead of printSet, and allow selective export without desrupting shared printSet.\n  -Export views on sheet seperatedly for dwg.\n  -Export from links or open docs.\n  -Merge pdf after export.\n  -JOKE while exporting.",
        "icon": "EnneadTab.tab\\Import Export.panel\\ennead_printer.bad_pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Import Export.panel\\ennead_printer.bad_pushbutton\\OLD_ennead_printer_script.py",
        "tab": "Import Export",
        "tab_icon": null
    },
    "EnneadTab.tab\\Import Export.panel\\export isolated walltype.pushbutton\\isolated export walltype_script.py": {
        "alias": "Isolated Export By System Family Type",
        "doc": "Export a separate DWG file for each wall, floor, roof, column, or stair type.\n\nPick a category and the types you care about, and every type is isolated in the\nview and written to its own file. Child elements such as shared families ride\nalong with their parent type.\n\nAimed at the system-family categories that are normally impossible to pull apart\nin a single DWG export. On the Rhino side, use Import Revit Export Collection to\nland each file under its own type parent layer.",
        "icon": "EnneadTab.tab\\Import Export.panel\\export isolated walltype.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Import Export.panel\\export isolated walltype.pushbutton\\isolated export walltype_script.py",
        "tab": "Import Export",
        "tab_icon": null
    },
    "EnneadTab.tab\\Import Export.panel\\export_ost_material_table.pushbutton\\export_ost_material_table_script.py": {
        "alias": "Export SubCategory Material Table",
        "doc": "Export the object style and material table so Rhino can match layers to materials.\n\nFeeds the Map Revit SubC tool in EnneadTab for Rhino: once this table exists,\neach Rhino layer can be given the Revit material that belongs to the matching\nsubcategory, and the two models finally agree on what is made of what.\n\nIf you have not done it yet, update the DWG export layer mapping with EnneadTab\nfirst, so subcategory names come out in a shape Rhino layer names can match.",
        "icon": "EnneadTab.tab\\Import Export.panel\\export_ost_material_table.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Import Export.panel\\export_ost_material_table.pushbutton\\export_ost_material_table_script.py",
        "tab": "Import Export",
        "tab_icon": null
    },
    "EnneadTab.tab\\Import Export.panel\\schedule2excel.pushbutton\\schedule2excel_script.py": {
        "alias": "Schedule2Excel",
        "doc": "Export and open schedule in excel.",
        "icon": "EnneadTab.tab\\Import Export.panel\\schedule2excel.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Import Export.panel\\schedule2excel.pushbutton\\schedule2excel_script.py",
        "tab": "Import Export",
        "tab_icon": null
    },
    "EnneadTab.tab\\Import Export.panel\\update_miro.pushbutton\\update_miro_script.py": {
        "alias": "Review On Miro",
        "doc": "Push selected sheets to a Miro board and keep markup alive across sheet updates.\n\nBecause each sheet image is replaced in place, comments and redlines stay stuck\nto the drawing instead of being thrown away with the old PDF every time the\nbackground changes. Review history survives the whole set of revisions.\n\nFeatures:\n- Sheets new to the board are flagged with a blue cross\n- Sheets whose background changed are flagged with an orange star\n- The last board URL you used is remembered for next time",
        "icon": "EnneadTab.tab\\Import Export.panel\\update_miro.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Import Export.panel\\update_miro.pushbutton\\update_miro_script.py",
        "tab": "Import Export",
        "tab_icon": null
    },
    "EnneadTab.tab\\Manage.panel\\Keynote Tags.pulldown\\wrong type of TAGS.pushbutton\\identy wrong keynote_script.py": {
        "alias": "Identify Wrong Type Of KeynoteTAG",
        "doc": "Find keynote tags that use the wrong tag family or point at a user keynote.\n\nA tag whose family or type name says material but that reads element keynote data\nis flagged, and the reverse case is flagged too. User keynotes, which the office\nstandard steers away from, are called out separately.\n\nFeatures:\n- Mismatched tags are color overridden in the view they sit in\n- User keynote tags are highlighted in blue\n- Run KeynoteTAG Reset Color afterwards to clear all the highlights",
        "icon": "EnneadTab.tab\\Manage.panel\\Keynote Tags.pulldown\\wrong type of TAGS.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Manage.panel\\Keynote Tags.pulldown\\wrong type of TAGS.pushbutton\\identy wrong keynote_script.py",
        "tab": "Manage",
        "tab_icon": null
    },
    "EnneadTab.tab\\Manage.panel\\Keynote Tags.pulldown\\z_reset all tag to default color.pushbutton\\reset tag color_script.py": {
        "alias": "KeynoteTAG Reset Color",
        "doc": "Clear the color overrides on every keynote tag so they draw in their default color.\n\nUse this after the keynote checking tools, which color-code tags to flag problems.\nTags or views owned by someone else in a workshared model are left alone and\nreported, so nothing is quietly half-reset.\n\nFeatures:\n- Sweeps every keynote tag in the model in a single undo step\n- Count of reset and skipped tags shown when it finishes",
        "icon": "EnneadTab.tab\\Manage.panel\\Keynote Tags.pulldown\\z_reset all tag to default color.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Manage.panel\\Keynote Tags.pulldown\\z_reset all tag to default color.pushbutton\\reset tag color_script.py",
        "tab": "Manage",
        "tab_icon": null
    },
    "EnneadTab.tab\\Manage.panel\\Merge Family.pushbutton\\Merge_Family_script.py": {
        "alias": "Merge Family",
        "doc": "Merge a few family types to a target family type: \n\nFor instance parameters, the tool tries to record as much information as it can, so after the merging, similar data can be applied back to maintain the graphical consistency.\n\nThere is a built-in check that will search for differences in type parameter data. Should differences be found, you will be prompted to decide to continue with merge or cancel.\n\nIf you find no ideal target type, you may also choose to create a new type under good family with the bad type data and type name.\n\nThis tool will work for most 2D and 3D families, as well as Tags.",
        "icon": "EnneadTab.tab\\Manage.panel\\Merge Family.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Manage.panel\\Merge Family.pushbutton\\Merge_Family_script.py",
        "tab": "Manage",
        "tab_icon": null
    },
    "EnneadTab.tab\\Manage.panel\\Shake All Tags.pushbutton\\shake all tags_script.py": {
        "alias": "Shake All Tags",
        "doc": "Force every tag on the sheets you pick to redraw itself with current text.\n\nFixes blank or stale tag text without leaving any permanent change behind: each\ntag is nudged, the view refreshes, and the tag is put straight back where it was.\nThe whole run is one undo step.\n\nFeatures:\n- Pinned tags are temporarily unpinned, then re-pinned\n- Tags owned by another user in a workshared model are skipped\n- Summary of shaken, refreshed, failed, and skipped tags when it finishes",
        "icon": "EnneadTab.tab\\Manage.panel\\Shake All Tags.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Manage.panel\\Shake All Tags.pushbutton\\shake all tags_script.py",
        "tab": "Manage",
        "tab_icon": null
    },
    "EnneadTab.tab\\Manage.panel\\abstract_wall.pushbutton\\abstract_wall_script.py": {
        "alias": "CurtainWall Location Manager",
        "doc": "Manage curtain wall locations by turning the walls in a plan into an abstract diagram.\n\nThe diagram gives you a clean line drawing to study and adjust curtain wall\npositions on. When the lines say what you want, run the tool again to push the\nlocations back onto the real curtain walls.\n\nFeatures:\n- Left click processes the current view; right click processes views you select\n- Edge of slab lines can be included when the floor type name contains \"struc\"\n- Export the diagram views to images with Manage Working Views for quick review",
        "icon": "EnneadTab.tab\\Manage.panel\\abstract_wall.pushbutton\\icon.png",
        "is_popular": false,
        "script": "EnneadTab.tab\\Manage.panel\\abstract_wall.pushbutton\\abstract_wall_script.py",
        "tab": "Manage",
        "tab_icon": null
