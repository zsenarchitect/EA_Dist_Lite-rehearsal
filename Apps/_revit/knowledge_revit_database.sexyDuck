    "EnneadTab.tab\\Resource.panel\\unit_test.pushbutton\\unit_test_script.py": {
        "alias": "Unit Test",
        "doc": "Run a self-check on the core EnneadTab services and report anything broken.\n\nReach for this when EnneadTab starts behaving strangely after an update. It\nexercises the shared services every other tool leans on and prints a pass or fail\nfor each one, which is worth pasting into a bug report.",
        "icon": "EnneadTab.tab\\Resource.panel\\unit_test.pushbutton\\icon.png",
