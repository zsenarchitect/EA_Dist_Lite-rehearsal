    "EnneadTab.tab\\Tools.panel\\Sync All.pulldown\\Sync and Quit.pushbutton\\sync_and_quit_script.py": {
        "alias": "Sync and Quit",
        "doc": "Sync every open model with central, close them all, and shut Revit down.\n\nThe one-click end of the day: nothing left open, nothing left unsynced. Revit\ncloses itself once the last model has finished syncing, so you can walk away.",
        "icon": "EnneadTab.tab\\Tools.panel\\Sync All.pulldown\\Sync and Quit.pushbutton\\icon.png",
        "is_popular": true,
        "script": "EnneadTab.tab\\Tools.panel\\Sync All.pulldown\\Sync and Quit.pushbutton\\sync_and_quit_script.py",
