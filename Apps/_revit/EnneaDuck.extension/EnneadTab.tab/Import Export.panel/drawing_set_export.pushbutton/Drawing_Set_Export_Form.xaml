<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EnneadTab Drawing Set Export"
        Width="580"
        Height="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        Background="#0A0E1A"
        Foreground="#E2E8F0">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="[ DRAWING SET EXPORT ]"
                       FontFamily="Consolas"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#00F0FF"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Per-sheet plan image + section-boxed 3D model for phone AR"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Foreground="#8A99AD"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Info / Room card -->
        <Border Grid.Row="1"
                Background="#121829"
                BorderBrush="#1E293B"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="status_text"
                           Text=">> Select sheets, then export"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="#00FF66"
                           TextWrapping="Wrap" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Room Code:"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Foreground="#94A3B8"
                               Margin="0,0,8,0" />
                    <TextBox x:Name="room_textbox"
                             Grid.Column="1"
                             Height="26"
                             Background="#0A0E1A"
                             Foreground="#FFE600"
                             BorderBrush="#334155"
                             Padding="6,2"
                             FontFamily="Consolas"
                             FontSize="12" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Sheet checklist -->
        <Border Grid.Row="2"
                Background="#121829"
                BorderBrush="#1E293B"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="[ SHEETS WITH FLOOR PLANS ]"
                           FontFamily="Consolas"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#00F0FF"
                           Margin="0,0,0,8" />
                <ScrollViewer Height="150" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="sheet_checklist" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="3">
            <Button x:Name="btn_export_beam"
                    Content="EXPORT DRAWING SET &amp; BEAM TO AR"
                    Height="40"
                    Background="#FF007F"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    Margin="0,0,0,10"
                    Click="on_export_beam_clicked" />

            <Button x:Name="btn_export_only"
                    Content="EXPORT ONLY (SAVE LOCALLY, NO UPLOAD)"
                    Height="34"
                    Background="#1E293B"
                    Foreground="#00F0FF"
                    BorderThickness="1"
                    BorderBrush="#334155"
                    Margin="0,0,0,10"
                    Click="on_export_only_clicked" />

            <Button x:Name="btn_open_web"
                    Content="OPEN AR/VR WEB HUB (BROWSER)"
                    Height="34"
                    Background="#121829"
                    Foreground="#FFE600"
                    BorderThickness="1"
                    BorderBrush="#334155"
                    Margin="0,0,0,10"
                    Click="on_open_web_clicked" />
        </StackPanel>

        <!-- Share Link / inline Dual QR -->
        <Border x:Name="share_link_card"
                Grid.Row="4"
                Background="#121829"
                BorderBrush="#1E293B"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="[ SCAN QR CODES &amp; SHARE LINKS ]"
                           FontFamily="Consolas"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#00FF66"
                           Margin="0,0,0,10"
                           HorizontalAlignment="Center" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#0A0E1A"
                            BorderBrush="#1E293B"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8">
                        <StackPanel>
                            <TextBlock Text="[ 1. MOBILE AR VIEW ]"
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#00FF66"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Big QR - scan on phone"
                                       FontFamily="Segoe UI"
                                       FontSize="9"
                                       Foreground="#8A99AD"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,6" />
                            <Image x:Name="qr_mobile_image"
                                   Width="160"
                                   Height="160"
                                   HorizontalAlignment="Center" />
                            <TextBox x:Name="mobile_link_textbox"
                                     IsReadOnly="True"
                                     Height="24"
                                     Margin="0,6,0,4"
                                     Background="#121829"
                                     Foreground="#00F0FF"
                                     BorderBrush="#334155"
                                     Padding="4,2"
                                     FontFamily="Consolas"
                                     FontSize="9" />
                            <Button x:Name="btn_copy_mobile"
                                    Content="COPY AR LINK"
                                    Height="24"
                                    Background="#0A0E1A"
                                    Foreground="#00FF66"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    FontSize="9"
                                    Click="on_copy_mobile_clicked" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="#0A0E1A"
                            BorderBrush="#1E293B"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8">
                        <StackPanel>
                            <TextBlock Text="[ 2. ROOM CONTROL PAGE ]"
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#FFE600"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Small QR - desktop hub"
                                       FontFamily="Segoe UI"
                                       FontSize="9"
                                       Foreground="#8A99AD"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,6" />
                            <Image x:Name="qr_room_image"
                                   Width="100"
                                   Height="100"
                                   Margin="0,30,0,30"
                                   HorizontalAlignment="Center" />
                            <TextBox x:Name="room_link_textbox"
                                     IsReadOnly="True"
                                     Height="24"
                                     Margin="0,6,0,4"
                                     Background="#121829"
                                     Foreground="#FFE600"
                                     BorderBrush="#334155"
                                     Padding="4,2"
                                     FontFamily="Consolas"
                                     FontSize="9" />
                            <Button x:Name="btn_copy_room"
                                    Content="COPY ROOM LINK"
                                    Height="24"
                                    Background="#0A0E1A"
                                    Foreground="#FFE600"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    FontSize="9"
                                    Click="on_copy_room_clicked" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="5" Margin="0,10,0,0">
            <TextBlock Text="enneadtab.com/arvr"
                       FontFamily="Consolas"
                       FontSize="10"
                       Foreground="#475569"
                       VerticalAlignment="Center" />
            <Button x:Name="btn_close"
                    Content="CLOSE"
                    Width="80"
                    Height="26"
                    Background="#0A0E1A"
                    Foreground="#64748B"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    HorizontalAlignment="Right"
                    Click="on_close_clicked" />
        </Grid>
    </Grid>
</Window>
