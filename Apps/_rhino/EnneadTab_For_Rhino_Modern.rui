    <macro_item guid="25b10f52-a5b6-49df-b20d-45f0e7f9781b" bitmap_id="a286277d-fba8-4705-bbc8-42a52358b68b">
      <text>
        <locale_1033>FlattenMeshFace</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Try to flatten the mesh face so there is no bump</locale_1033>
      </tooltip>
      <help_text>
        <locale_1033>Try to flatten the mesh face so there is no bump</locale_1033>
