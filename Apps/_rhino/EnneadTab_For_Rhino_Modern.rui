    <macro_item guid="a9e23a68-ac90-4104-8902-56a4b083cd51" bitmap_id="9b3fd901-6426-4e19-8708-2e105d9e6dc8">
      <text>
        <locale_1033>DVD</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Classic DVD screensaver animation for Rhino.

A nostalgic entertainment feature that recreates the 
bouncing DVD logo animation within Rhino viewport.</locale_1033>
      </tooltip>
      <help_text>
        <locale_1033>Classic DVD screensaver animation for Rhino.

