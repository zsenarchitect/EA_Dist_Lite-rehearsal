    },
    "Layer.tab\\apply_color_book.button\\apply_color_book_left.py": {
        "script": "Layer.tab\\apply_color_book.button\\apply_color_book_left.py",
        "icon": "Layer.tab\\apply_color_book.button\\icon.png",
        "alias": "ApplyColorBook",
        "doc": "Apply the office Color Book to Rhino layer colors - no Excel needed.\n\nPulls the project's resolved color book from enneadtab.com (Department + Program swatches) and\nrecolors every layer whose name or abbreviation matches a swatch. Sign in once when prompted.\n\nKey Features:\n- Online source: colors live at enneadtab.com/color-book, not a scattered Excel\n- Matches layers by name OR abbreviation (case-insensitive, exact)\n- Reports how many layers were recolored\n- Same office standard the Revit ColorScheme tool uses (shared COLOR library)",
        "tab": "Layer.tab",
        "tab_icon": "Layer.tab\\icon.png",
        "is_popular": true
    },
    "Layer.tab\\destroy_layer.button\\destroy_layer_left.py": {
        "script": "Layer.tab\\destroy_layer.button\\destroy_layer_left.py",
        "icon": "Layer.tab\\destroy_layer.button\\icon.png",
        "alias": "DestroyLayer",
        "doc": "Delete layers outright, even when they still hold objects.\n\nRhino normally refuses to remove a layer that is in use, especially when a block definition\nis holding it hostage. This clears the objects out and takes the layer with them, so a\nbloated layer tree can finally be pruned.\n\nUsage:\n1. Run the button and pick the layers to remove\n2. The layers and everything on them are gone once you confirm",
        "tab": "Layer.tab",
        "tab_icon": "Layer.tab\\icon.png",
        "is_popular": false
    },
