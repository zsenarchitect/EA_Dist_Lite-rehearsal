        "doc": "Listen to changes in the miro",
        "tab": "Web.tab",
        "tab_icon": "Web.tab\\icon.png",
        "is_popular": false
    },
    "Web.tab\\miro.button\\push_to_miro_right.py": {
        "script": "Web.tab\\miro.button\\push_to_miro_right.py",
        "icon": "Web.tab\\miro.button\\icon.png",
        "alias": "PushToMiro",
