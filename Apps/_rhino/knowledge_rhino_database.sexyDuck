    "EnneadTab.menu\\self_repair.button\\self_repair_left.py": {
        "script": "EnneadTab.menu\\self_repair.button\\self_repair_left.py",
        "icon": "EnneadTab.menu\\self_repair.button\\icon.png",
        "alias": "SelfRepair",
        "doc": "Repair a stale EnneadTab installation and pull the latest version.\n\nRun it when buttons are missing, point at the wrong tool, or still carry an old name.\nThe toolbars are checked for out-of-date entries and, if any are found, the newest\nEnneadTab is fetched and installed for you.\n\nFeatures:\n- Spots toolbars left over from an older EnneadTab release\n- Fetches and installs the current version automatically\n- Nothing happens if your installation is already current",
        "tab": "EnneadTab.menu",
        "tab_icon": "EnneadTab.menu\\icon.png",
        "is_popular": false
    },
